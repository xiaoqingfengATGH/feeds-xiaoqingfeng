{
	"luci-app-homevpn": {
		"description": "Grant access to HomeVPN IKEv2 server management",
		"read": {
			"ubus": {
				"homevpn": [ "status", "list_users", "get_settings", "discover_acme", "download" ]
			},
			"uci": [ "homevpn" ]
		},
		"write": {
			"ubus": {
				"homevpn": [ "set_enabled", "add_user", "del_user", "set_user_ip", "set_settings", "provision", "upload_certs" ]
			},
			"uci": [ "homevpn" ],
			"file": {
				"/etc/init.d/homevpn": [ "exec" ],
				"/usr/libexec/rpcd/homevpn": [ "exec" ]
			}
		}
	}
}

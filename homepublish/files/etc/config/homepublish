config service 'main'
	option enabled '0'
	option exposure_approved '0'
	option publication_enabled '0'
	# Reference only; root-owned 0600 credential, never a plaintext UCI secret.
	option router_token_file '/etc/homepublish/router.token'
	option listen '127.0.0.1'
	option port '18443'
	option bind_port '18444'
	option ttl '60'
	option stun_server 'turn.cloudflare.com'
	option http_server 'example.com'
	option cert '/etc/homepublish/cert.pem'
	option key '/etc/homepublish/key.pem'

# Add explicitly reviewed host sections before enabling. No upstream defaults.

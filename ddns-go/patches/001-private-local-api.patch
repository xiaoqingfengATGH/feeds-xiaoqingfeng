+package dns
+
+import (
+	"github.com/jeessy2/ddns-go/v6/config"
+	"github.com/jeessy2/ddns-go/v6/util"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestLocalUpdateSerializesRunOnce(t *testing.T) {
+	t.Setenv(util.ConfigFilePathENV, filepath.Join(t.TempDir(), "config.yaml"))
+	c := config.Config{}
+	if err := c.SaveConfig(); err != nil {
+		t.Fatal(err)
+	}
+	runLock.Lock()
+	done := make(chan struct{})
+	go func() { runOnce(true); close(done) }()
+	select {
+	case <-done:
+		runLock.Unlock()
+		t.Fatal("worker bypassed RunOnce serialization")
+	case <-time.After(20 * time.Millisecond):
+	}
+	runLock.Unlock()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("worker blocked")
+	}
+}
+func TestLocalUpdateCoalesces(t *testing.T) {
+	for len(localUpdates) > 0 {
+		<-localUpdates
+	}
+	for i := 0; i < 100; i++ {
+		RequestUpdate()
+	}
+	if len(localUpdates) != 1 {
+		t.Fatal("queue is not bounded/coalescing")
+	}
+	<-localUpdates
+}
diff --git a/localapi/api.go b/localapi/api.go
new file mode 100644
index 0000000..b48d2eb
--- /dev/null
+++ b/localapi/api.go
@@ -0,0 +1,95 @@
+// Package localapi provides the opt-in, filesystem-authorized API, never WebUI routes.
+package localapi
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"github.com/jeessy2/ddns-go/v6/config"
+	"net/http"
+	"strings"
+)
+
+type API struct {
+	load  func() (config.Config, error)
+	save  func(*config.Config) error
+	queue func()
+}
+type Family struct {
+	Enabled bool     `json:"enabled"`
+	Domains []string `json:"domains"`
+}
+type Profile struct {
+	ID       string `json:"profile_id"`
+	Name     string `json:"name"`
+	Provider string `json:"provider"`
+	A        Family `json:"a"`
+	AAAA     Family `json:"aaaa"`
+}
+
+// profileID uses only position and public labels, never credentials or their hashes.
+// The ordered label list makes selectors stale on reordering. Identical labels are
+// indistinguishable: give profiles distinct names before using this API.
+func profileID(c config.Config, index int) string {
+	labels := make([][2]string, len(c.DnsConf))
+	for i, d := range c.DnsConf {
+		labels[i] = [2]string{d.Name, d.DNS.Name}
+	}
+	b, _ := json.Marshal(labels)
+	sum := sha256.Sum256(b)
+	return fmt.Sprintf("p%d-%s", index, hex.EncodeToString(sum[:12]))
+}
+func domainName(s string) string {
+	s = strings.TrimSpace(strings.SplitN(s, "?", 2)[0])
+	if p := strings.Split(s, ":"); len(p) == 2 {
+		if p[0] == "@" || p[0] == "" {
+			s = p[1]
+		} else {
+			s = p[0] + "." + p[1]
+		}
+	}
+	return strings.ToLower(strings.TrimSuffix(s, "."))
+}
+func safeDomains(ds []string) []string {
+	out := []string{}
+	for _, s := range ds {
+		out = append(out, domainName(s))
+	}
+	return out
+}
+func reply(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	json.NewEncoder(w).Encode(v)
+}
+func New(load func() (config.Config, error), save func(*config.Config) error, queue func()) http.Handler {
+	a := &API{load: load, save: save, queue: queue}
+	m := http.NewServeMux()
+	m.HandleFunc("/v1/domains/ensure", a.ensure)
+	m.HandleFunc("/v1/profiles", a.profiles)
+	m.HandleFunc("/v1/health", func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != "GET" {
+			w.WriteHeader(405)
+			return
+		}
+		reply(w, 200, map[string]any{"api_version": 1})
+	})
+	return m
+}
+func (a *API) profiles(w http.ResponseWriter, r *http.Request) {
+	if r.Method != "GET" {
+		w.WriteHeader(405)
+		return
+	}
+	c, err := a.load()
+	if err != nil {
+		reply(w, 503, map[string]string{"error": "config_unavailable"})
+		return
+	}
+	ps := []Profile{}
+	for i, d := range c.DnsConf {
+		ps = append(ps, Profile{profileID(c, i), d.Name, d.DNS.Name, Family{d.Ipv4.Enable, safeDomains(d.Ipv4.Domains)}, Family{d.Ipv6.Enable, safeDomains(d.Ipv6.Domains)}})
+	}
+	reply(w, 200, map[string]any{"api_version": 1, "profiles": ps})
+}

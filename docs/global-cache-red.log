 and group.childNodes[data-tab], so panels must stay\r\n\t\t\t\t   direct children: wrap the WHOLE group (menu + panels)\r\n\t\t\t\t   as a single card instead */\r\n\t\t\t\tjQuery(".cbi-map-tabbed").each(function(i, e) {\r\n\t\t\t\t\tlet mt = jQuery(e);\r\n\t\t\t\t\tif (mt.closest(\'.card\').length > 0)\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\tlet menu = mt.prev(\'ul.cbi-tabmenu\');\r\n\t\t\t\t\tlet target = (menu.length > 0 ? menu : jQuery()).add(mt);\r\n\t\t\t\t\ttarget.wrapAll(\'<div class="card"></div>\').wrapAll(\'<div class="col-12"></div>\');\r\n\t\t\t\t\tmt.children(\'.cbi-section\').addClass(\'card-body\');\r\n\t\t\t\t});\r\n\r\n\t\t\t\tjQuery("div.cbi-section:not(fieldset)").each(function(i, e) {\r\n\t\t\t\t\tlet el = jQuery(e);\r\n\t\t\t\t\t/* already wrapped, or a nested section inside a tab\r\n\t\t\t\t\t   panel (1.2 keeps those inside the tab content area,\r\n\t\t\t\t\t   not as separate cards). form.js always renders the\r\n\t\t\t\t\t   node as a CHILD of its .cbi-section; hand-rolled\r\n\t\t\t\t\t   views (partexp) emit a top-level div carrying BOTH\r\n\t\t\t\t\t   classes on the same element - that one IS the\r\n\t\t\t\t\t   section and must be cardified. */\r\n\t\t\t\t\tif (el.closest(\'.card\').length > 0\r\n\t\t\t\t\t    || (el.hasClass(\'cbi-section-node\') && !el.hasClass(\'cbi-section\')))\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\tif (el.closest(\'.cbi-tabcontainer\').length > 0)\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\tif (el.closest(\'.cbi-map-tabbed\').length > 0)\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t/* ui.tabs panes (nlbw display, status/iptables, ...) carry\r\n\t\t\t\t\t   data-tab themselves and MUST stay direct children of\r\n\t\t\t\t\t   their group container: switchTab() resolves panes via\r\n\t\t\t\t\t   menu.nextElementSibling.childNodes. Cardifying them\r\n\t\t\t\t\t   individually here would defeat the shared-card path in\r\n\t\t\t\t\t   wrapBareView() below (group.children(\'[data-tab]\') would\r\n\t\t\t\t\t   find only col-12 wrappers) and the menu would get its\r\n\t\t\t\t\t   own card - breaking menu/group adjacency so tabs change\r\n\t\t\t\t\t   the highlight but never the content. */\r\n\t\t\t\t\tif (el.attr(\'data-tab\') !== undefined)\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\tlet col = jQuery(\'<div class="col-12"></div>\');\r\n\t\t\t\t\tlet card = jQuery(\'<div class="card"></div>\');\r\n\t\t\t\t\tel.wrap(col);\r\n\t\t\t\t\tel.wrap(card);\r\n\t\t\t\t\tel.addClass(\'card-body\');\r\n\t\t\t\t});\r\n\t\t\t}\r\n\r\n\t\t\t/* "bare" modern views (crontab, processes, startup, ...) have\r\n\t\t\t   no cbi-section markup at all - wrap their main content in a\r\n\t\t\t   card so they get the same look the legacy server rendered\r\n\t\t\t   CBI pages had */\r\n\t\t\tfunction wrapBareView() {\r\n\t\t\t\t/* Bare views may use ui.tabs directly (status/iptables,\r\n\t\t\t\t   nlw display ...): #view contains a generated\r\n\t\t\t\t   ul.cbi-tabmenu immediately followed by one plain div\r\n\t\t\t\t   whose direct children are [data-tab] panes.\r\n\t\t\t\t   ui.tabs.switchTab() resolves panes strictly through\r\n\t\t\t\t   menu.nextElementSibling.childNodes. Wrapping menu and\r\n\t\t\t\t   group as separate cards breaks that contract: the tab\r\n\t\t\t\t   highlight changes but data-tab-active/content never\r\n\t\t\t\t   does. Keep both as adjacent siblings inside one shared\r\n\t\t\t\t   card-body.\r\n\r\n\t\t\t\t   This must run BEFORE the bare-view early exit below:\r\n\t\t\t\t   ui.tabs panes are div.cbi-section[data-tab] themselves\r\n\t\t\t\t   (nlbw display), so the .cbi-section probe would wrongly\r\n\t\t\t\t   classify the view as non-bare and return before ever\r\n\t\t\t\t   wrapping - leaving menu and panes sitting directly on\r\n\t\t\t\t   the wallpaper background. */\r\n\t\t\t\tjQuery(viewEl).children(\'ul.cbi-tabmenu\').each(function(i, e) {\r\n\t\t\t\t\tlet menu = jQuery(e);\r\n\t\t\t\t\tlet group = menu.next();\r\n\t\t\t\t\tif (group.length == 0 || group.children(\'[data-tab]\').length == 0)\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t/* already cardified (this run, an observer re-run or a\r\n\t\t\t\t\t   poll rebuild): wrapAll on a wrapped pair would nest\r\n\t\t\t\t\t   another card layer on every pass */\r\n\t\t\t\t\tif (menu.closest(\'.card\').length > 0)\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\tlet target = menu.add(group);\r\n\t\t\t\t\ttarget.wrapAll(\'<div class="card-body"></div>\');\r\n\t\t\t\t\tlet body = menu.parent();\r\n\t\t\t\t\tbody.wrap(\'<div class="card"></div>\');\r\n\t\t\t\t\tbody.parent().wrap(\'<div class="col-12"></div>\');\r\n\t\t\t\t});\r\n\r\n\t\t\t\t/* anything already cardified (incl. our own col-12/card\r\n\t\t\t\t   wrappers - matching them here again would nest a new\r\n\t\t\t\t   card layer on every poll and grow the DOM forever) */\r\n\t\t\t\tif (viewEl.querySelector(\'.cbi-section, .cbi-map .card\') != null\r\n\t\t\t\t    || viewEl.firstElementChild?.classList.contains(\'col-12\'))\r\n\t\t\t\t\treturn;\r\n\r\n\t\t\t\tlet main = jQuery(viewEl).children().filter(function(i, e) {\r\n\t\t\t\t\treturn !e.matches(\'h2, .cbi-map-descr, .cbi-section-descr, .cbi-page-actions, script, .spinning, .col-12\');\r\n\t\t\t\t});\r\n\r\n\t\t\t\t/* Two shapes of bare content:\r\n\t\t\t\t   - structural containers (form, div, table, textarea...):\r\n\t\t\t\t     one card EACH - diagnostics shows one card per tool,\r\n\t\t\t\t     processes one card for its table. Keep as-is.\r\n\t\t\t\t   - small flow elements only (system/reboot is\r\n\t\t\t\t     p + hr + button): wrap them TOGETHER in ONE shared\r\n\t\t\t\t     card. Cardifying each separately made three slivers,\r\n\t\t\t\t     and addClass(\'card-body\') on the <button> itself put\r\n\t\t\t\t     card padding + block display on it - a full-width\r\n\t\t\t\t     70px slab instead of a button. */\r\n\t\t\t\tlet smallOnly = main.length > 0 && main.toArray().every(function(e) {\r\n\t\t\t\t\treturn e.matches(\'p, hr, button, a, span, small, em, strong\');\r\n\t\t\t\t});\r\n\r\n\t\t\t\tif (smallOnly) {\r\n\t\t\t\t\tif (main.closest(\'.card\').length > 0)\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\tmain.wrapAll(\'<div class="card-body"></div>\');\r\n\t\t\t\t\tlet body = main.parent();\r\n\t\t\t\t\tbody.wrap(\'<div class="card"></div>\');\r\n\t\t\t\t\tbody.parent().wrap(\'<div class="col-12"></div>\');\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tmain.each(function(i, e) {\r\n\t\t\t\t\tlet el = jQuery(e);\r\n\t\t\t\t\tif (el.closest(\'.card\').length > 0)\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\tel.wrap(\'<div class="col-12"></div>\');\r\n\t\t\t\t\tel.wrap(\'<div class="card"></div>\');\r\n\t\t\t\t\tel.addClass(\'card-body\');\r\n\r\n\t\t\t\t\t/* renderPage only wraps table.cbi-section-table in\r\n\t\t\t\t\t   .table-responsive - plain view tables need it too */\r\n\t\t\t\t\tel.find(\'table\').addBack(\'table\').each(function(j, tb) {\r\n\t\t\t\t\t\tif (jQuery(tb).closest(\'.table-responsive\').length == 0)\r\n\t\t\t\t\t\t\tjQuery(tb).wrap(\'<div class="table-responsive"></div>\');\r\n\t\t\t\t\t});\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t\tjQuery("div.cbi-section > h3, div.cbi-section > h4").addClass(\'header-title mb-3\');\r\n\t\t\tjQuery("div.cbi-map > .cbi-section > h3:first-child").css(\'font-size\', \'large\');\r\n\r\n\t\t\twrapSections();\r\n\t\t\twrapBareView();\r\n\t\t\tstyl'... 15052 more characters,

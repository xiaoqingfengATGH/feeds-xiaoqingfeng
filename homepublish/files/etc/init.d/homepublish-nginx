#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=9
start_service() {
 test -f /tmp/homepublish-device/runtime/nginx.conf || return 1
 procd_open_instance dedicated
 procd_set_param command /usr/sbin/nginx -p /tmp/homepublish-device/runtime/ -c nginx.conf
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param term_timeout 5
 procd_close_instance
}

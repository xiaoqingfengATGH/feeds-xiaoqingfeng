@@ -0,0 +1,65 @@
+package localapi
+
+import (
+	"github.com/jeessy2/ddns-go/v6/config"
+	"github.com/jeessy2/ddns-go/v6/util"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestNativePersistenceAndCacheFailure(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "config.yaml")
+	t.Setenv(util.ConfigFilePathENV, path)
+	original := fixture()
+	original.Username = "fixture-user"
+	original.WebhookURL = "https://example.invalid/hook"
+	original.DnsConf[0].TTL = "900"
+	original.DnsConf[0].Ipv4.Cmd = "fixture-only"
+	original.Lang = "en"
+	if err := original.SaveConfig(); err != nil {
+		t.Fatal(err)
+	}
+	cached, err := config.GetConfigCached()
+	if err != nil {
+		t.Fatal(err)
+	}
+	id := profileID(cached, 0)
+	queued := 0
+	h := New(config.GetConfigCached, (*config.Config).SaveConfig, func() { queued++ })
+	send := func(host string) int {
+		r := httptest.NewRecorder()
+		req := httptest.NewRequest("POST", "/v1/domains/ensure", strings.NewReader(`{"profile_id":"`+id+`","hostname":"`+host+`","record_types":["A","AAAA"]}`))
+		req.Header.Set("Content-Type", "application/json")
+		h.ServeHTTP(r, req)
+		return r.Code
+	}
+	// Real SaveConfig failure after loading the cache, without mutating its slices.
+	os.Setenv(util.ConfigFilePathENV, filepath.Join(dir, "missing", "config.yaml"))
+	if send("fail.example.com") != 500 {
+		t.Fatal("expected real persistence failure")
+	}
+	after, _ := config.GetConfigCached()
+	if !reflect.DeepEqual(cached, after) || queued != 0 {
+		t.Fatal("cache changed after failed save")
+	}
+	os.Setenv(util.ConfigFilePathENV, path)
+	if send("new.example.com") != 200 {
+		t.Fatal("save failed")
+	}
+	after, err = config.GetConfigCached()
+	if err != nil {
+		t.Fatal(err)
+	}
+	expected := original
+	expected.DnsConf = append([]config.DnsConfig(nil), original.DnsConf...)
+	expected.DnsConf[0].Ipv4.Domains = append(append([]string(nil), original.DnsConf[0].Ipv4.Domains...), "new.example.com")
+	expected.DnsConf[0].Ipv6.Domains = []string{"new.example.com"}
+	if !reflect.DeepEqual(expected, after) || queued != 1 {
+		t.Fatalf("supported fields not preserved: %#v", after)
+	}
+}
diff --git a/localapi/socket.go b/localapi/socket.go
new file mode 100644
index 0000000..67aa6a9
--- /dev/null
+++ b/localapi/socket.go
@@ -0,0 +1,53 @@
+package localapi
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"syscall"
+	"time"
+)
+
+// Listen requires an existing private directory. A stale socket is removed only
+// after a failed dial; regular files and live listeners are never replaced.
+func Listen(path string) (net.Listener, error) {
+	if !filepath.IsAbs(path) {
+		return nil, fmt.Errorf("local API path must be absolute")
+	}
+	st, err := os.Lstat(filepath.Dir(path))
+	if err != nil {
+		return nil, err
+	}
+	if !st.IsDir() || st.Mode().Perm()&0077 != 0 {
+		return nil, fmt.Errorf("local API directory must be private")
+	}
+	if st, err := os.Lstat(path); err == nil {
+		if st.Mode()&os.ModeSocket == 0 {
+			return nil, fmt.Errorf("local API path is not a socket")
+		}
+		c, e := net.DialTimeout("unix", path, time.Second)
+		if e == nil {
+			c.Close()
+			return nil, fmt.Errorf("local API socket already active")
+		}
+		if !errors.Is(e, syscall.ECONNREFUSED) {
+			return nil, fmt.Errorf("cannot establish stale socket: %w", e)
+		}
+		if err := os.Remove(path); err != nil {
+			return nil, err
+		}
+	} else if !os.IsNotExist(err) {
+		return nil, err
+	}
+	l, err := net.Listen("unix", path)
+	if err != nil {
+		return nil, err
+	}
+	if err := os.Chmod(path, 0600); err != nil {
+		l.Close()
+		return nil, err
+	}
+	return l, nil
+}

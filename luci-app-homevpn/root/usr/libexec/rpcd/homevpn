#!/bin/sh
# =============================================================================
# homevpn — rpcd backend for luci-app-homevpn
# Provisioning + EAP user management + client profiles (.mobileconfig/.sswan/CA)
# for the router-local strongSwan IKEv2 server.
# Based on luci-app-ikev2-manager (C) naughtyGitCat, MIT.
# =============================================================================
. /usr/share/libubox/jshn.sh

CFG="homevpn"
SWANCTL="/etc/swanctl"
CONN_FILE="$SWANCTL/conf.d/homevpn.conf"
SECRETS_FILE="$SWANCTL/conf.d/homevpn-eap.conf"
CA_SELF="$SWANCTL/x509ca/homevpn-ca.crt"
CA_ACME="$SWANCTL/x509ca/homevpn-acme.crt" # legacy single-file layout (pre-r22)
ACME_CHAIN_GLOB="$SWANCTL/x509ca/homevpn-acme-*.crt"
SRV_CERT="$SWANCTL/x509/homevpn-server.crt"
ACME_RESOLVER="/usr/share/homevpn/acme-resolve.sh"

cfg() { uci -q get "${CFG}.config.$1"; }

# shared ACME resolver (same code as the init script — single source of truth)
. "$ACME_RESOLVER" || { echo "homevpn-rpcd: missing $ACME_RESOLVER" >&2; }
# resolver contract: HV_ACME_CRT (fullchain, leaf first) + HV_ACME_KEY
acme_ready() { homevpn_acme_resolve "$1" "${2:-$(cfg acme_key_type)}"; }

err() { json_init; json_add_boolean ok 0; json_add_string error "$1"; json_dump; exit 0; }
ok()  { json_add_boolean ok 1; }
valid_name() { echo "$1" | grep -qE '^[A-Za-z0-9_.-]{1,32}$'; }

active_mode() {
	local m; m="$(cfg cert_mode)"; [ -n "$m" ] || m=selfsigned
	# report the configured mode truthfully; init keeps the deployed cert
	# on ACME sync failure (no silent self-signed fallback)
	echo "$m"
}

CA_DIR="$SWANCTL/x509ca"; X509_DIR="$SWANCTL/x509"; KEY_DIR="$SWANCTL/private"
. /usr/share/homevpn/selfsigned-pki.sh
effective_remote() { cfg remote; }

# Exact SAN membership: charon binds local.id (the server address) to a
# certificate ONLY on an exact SAN match — wildcard SANs (*.example.com)
# NEVER match (strongSwan does not support wildcard certificates; an address
# only wildcard-covered makes every IKE_AUTH fail with AUTH_FAILED and
# "no private key found"). Case-insensitive; DNS: and IP: forms accepted.
# $1 = name-or-IP, $2 = certificate file.
san_exact_match() {
	local want s
	[ -s "$2" ] || return 1
	want="$(printf '%s' "$1" | tr 'a-z' 'A-Z')"
	for s in $(openssl x509 -in "$2" -noout -ext subjectAltName 2>/dev/null | tail -n +2 | tr -d ' \n' | tr 'a-z' 'A-Z' | sed 's/IPADDRESS:/IP:/g' | tr ',' ' '); do
		[ "DNS:$want" = "$s" ] || [ "IP:$want" = "$s" ] && return 0
	done
	return 1
}

# CA to embed in client profiles: the ACME chain root (the LAST cert of the
# chain, e.g. ISRG Root X2) — it is the anchor clients must trust. New layout
# (r22+): homevpn-acme-NN.crt, one cert per file (the first file is an
# intermediate — openssl x509 reads exactly one cert, so read the LAST file).
# Legacy fallback: single homevpn-acme.crt (multi-PEM — same last-cert rule,
# but pre-r22 it held only the root anyway).
ca_file() {
	local f last
	if [ "$(active_mode)" = selfsigned ]; then
		hv_pki_ca_valid && echo "$CA_SELF"; return
	fi
	for f in $ACME_CHAIN_GLOB; do
		[ -s "$f" ] && last="$f"
	done
	[ -n "$last" ] && { echo "$last"; return; }
	[ -s "$CA_ACME" ] && { echo "$CA_ACME"; return; }
	[ -s "$CA_SELF" ] && echo "$CA_SELF"
}

regen_secrets() {
	# delegate to the init script's regen (single source of truth):
	# regenerates secrets + swanctl conf AND runs `swanctl --load-all`,
	# so newly added/removed EAP users are live in charon immediately
	# (without load-all, charon keeps its in-memory secrets and EAP auth
	# for the new user fails with "EAP-MS-CHAPv2 verification failed").
	if ! /etc/init.d/homevpn regen >/tmp/homevpn-regen.log 2>&1; then
		json_init
		json_add_boolean ok 0
		json_add_boolean saved 1
		json_add_string error "Changes saved, but application failed."
		json_add_string output "$(cat /tmp/homevpn-regen.log)"
		json_dump
		exit 0
	fi
}

user_index() {
	local i=0
	while uci -q get "${CFG}.@user[$i]" >/dev/null 2>&1; do
		[ "$(uci -q get "${CFG}.@user[$i].name")" = "$1" ] && { echo "$i"; return; }
		i=$((i+1))
	done
}

plist_header() { # $1=vpn_name $2=name $3=uuid
cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
PLIST
}

hv_rpc_dispatch() {
case "$1" in
list)
	json_init
	json_add_object "set_enabled"; json_add_boolean enabled 0; json_close_object
	json_add_object "status";       json_close_object
	json_add_object "list_users";   json_close_object
	json_add_object "add_user";     json_add_string name ""; json_add_string password ""; json_close_object
	json_add_object "del_user";     json_add_string name ""; json_close_object
	json_add_object "set_user_ip";  json_add_string name ""; json_add_string ip ""; json_close_object
	json_add_object "discover_acme"; json_add_string domain ""; json_close_object
	json_add_object "get_settings"; json_close_object
	json_add_object "set_settings"; json_add_string remote ""; json_add_string vpn_name ""; json_add_string cert_mode ""; json_add_string acme_domain ""; json_add_string acme_key_type ""; json_add_string ip_mode ""; json_add_string pool_start ""; json_add_string pool_end ""; json_add_string pool_subnet ""; json_add_string masq ""; json_close_object
	json_add_object "ensure_selfsigned_ca"; json_add_boolean replace 0; json_add_string fingerprint ""; json_close_object
	json_add_object "provision";    json_close_object
	json_add_object "upload_certs"; json_add_string server ""; json_add_string key ""; json_add_string ca ""; json_close_object
	json_add_object "download";     json_add_string name ""; json_add_string what ""; json_close_object
	json_dump
	;;
call)
	method="$2"; read -r input; [ -n "$input" ] && json_load "$input"
	case "$method" in
	set_enabled)
		json_get_type enabled_type enabled
		[ "$enabled_type" = boolean ] || err "enabled must be a boolean"
		json_get_var enabled enabled
		case "$enabled" in 0|1) ;; *) err "enabled must be a boolean";; esac
		out="$(/etc/init.d/homevpn set-enabled "$enabled" 2>&1)"; rc=$?
		[ "$rc" = 0 ] || err "${out:-service state change failed}"
		json_init; ok
		json_add_boolean enabled "$([ "$(cfg enabled)" != 0 ] && echo 1 || echo 0)"
		json_dump
		;;
	status)
		hv_pki_recover || err "$HV_PKI_ERROR"
		json_init; ok
		json_add_boolean enabled "$([ "$(cfg enabled)" != 0 ] && echo 1 || echo 0)"
		json_add_boolean boot_enabled "$(/etc/init.d/homevpn enabled >/dev/null 2>&1 && echo 1 || echo 0)"
		json_add_boolean running "$(pidof charon >/dev/null && echo 1 || echo 0)"
		json_add_boolean listening "$(netstat -lnu 2>/dev/null | grep -qE ':(500|4500) ' && echo 1 || echo 0)"
		json_add_string  mode "$(active_mode)"
		json_add_string  remote "$(effective_remote)"
		caf="$(ca_file)"
		ready=0
		if [ -n "$(effective_remote)" ] && [ -n "$caf" ] && san_exact_match "$(effective_remote)" "$SRV_CERT"; then
			if [ "$(active_mode)" = selfsigned ]; then hv_pki_leaf_valid "$(effective_remote)" 0 && ready=1; else ready=1; fi
		fi
		json_add_boolean pki_ready "$ready"
		if [ "$(active_mode)" = selfsigned ]; then
			ca_valid=0; hv_pki_ca_valid && ca_valid=1
			json_add_object selfsigned
			json_add_boolean ca_valid "$ca_valid"
			json_add_string ca_reason "$HV_PKI_ERROR"
			json_add_string fingerprint "$(openssl x509 -in "$CA_SELF" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2)"
			json_add_string notafter "$(openssl x509 -in "$CA_SELF" -noout -enddate 2>/dev/null | cut -d= -f2)"
			json_add_boolean ca_expiring "$(openssl x509 -in "$CA_SELF" -checkend 2592000 -noout >/dev/null 2>&1 && echo 0 || echo 1)"
			leaf_state=remote_required
			if [ -n "$(effective_remote)" ]; then
				if hv_pki_leaf_valid "$(effective_remote)" 2592000; then leaf_state=ready; else leaf_state="$HV_PKI_ERROR"; fi
			fi
			json_add_string leaf_state "$leaf_state"
			json_close_object
		fi
		# ACME prerequisite: resolvable certificate + key for the domain?
		acme_dom="$(cfg acme_domain)"
		if [ -n "$acme_dom" ] && acme_ready "$acme_dom"; then
			json_add_boolean acme_ready 1
		else
			json_add_boolean acme_ready 0
		fi
		# SAN check: the server address must EXACTLY equal one SAN of the
		# deployed certificate — the same rule charon applies when binding
		# local.id to a certificate. Wildcard SANs (*.example.com) NEVER
		# match: strongSwan does not support wildcard certificates, so an
		# address only wildcard-covered is a hard mismatch (every IKE_AUTH
		# would fail with AUTH_FAILED and "no private key found").
		san_ok=0
		if [ -n "$caf" ] && [ -s "$SRV_CERT" ]; then
			san_exact_match "$(effective_remote)" "$SRV_CERT" && san_ok=1
		fi
		json_add_boolean san_ok "$san_ok"
		# deployed certificate details (import-mode info panel)
		if [ -s "$SRV_CERT" ]; then
			json_add_object cert
			json_add_string source "$(hv_pki_cert_source)"
			json_add_string fingerprint "$(hv_pki_cert_fingerprint "$SRV_CERT")"
			json_add_string subject "$(openssl x509 -in "$SRV_CERT" -noout -subject 2>/dev/null | sed 's/^subject=//')"
			json_add_string issuer "$(openssl x509 -in "$SRV_CERT" -noout -issuer 2>/dev/null | sed 's/^issuer=//')"
			json_add_string san "$(openssl x509 -in "$SRV_CERT" -noout -ext subjectAltName 2>/dev/null | tail -n +2 | tr -d ' ' | tr '\n' ',' | sed 's/,$//')"
			json_add_string notafter "$(openssl x509 -in "$SRV_CERT" -noout -enddate 2>/dev/null | cut -d= -f2)"
			expiry=ok
			openssl x509 -in "$SRV_CERT" -checkend 0 -noout >/dev/null 2>&1 || expiry=expired
			[ "$expiry" = ok ] && ! openssl x509 -in "$SRV_CERT" -checkend 2592000 -noout >/dev/null 2>&1 && expiry=soon
			json_add_string expiry "$expiry"
			if [ -s "$SWANCTL/private/homevpn-server.key" ]; then
				cp1="$(openssl x509 -in "$SRV_CERT" -pubkey -noout 2>/dev/null | openssl sha256 2>/dev/null | awk '{print $NF}')"
				kp1="$(openssl pkey -in "$SWANCTL/private/homevpn-server.key" -pubout 2>/dev/null | openssl sha256 2>/dev/null | awk '{print $NF}')"
				json_add_boolean key_matches "$([ -n "$cp1" ] && [ "$cp1" = "$kp1" ] && echo 1 || echo 0)"
			fi
			caf1="$(ca_file)"
			[ -n "$caf1" ] && json_add_string ca_subject "$(openssl x509 -in "$caf1" -noout -subject 2>/dev/null | sed 's/^subject=//')"
			json_close_object
		fi
		json_add_boolean input_rules "$(/etc/init.d/firewall status >/dev/null 2>&1; uci -q get firewall.homevpn_nat_t >/dev/null && echo 1 || echo 0)"
		json_add_boolean conn_loaded "$(swanctl --list-conn 2>/dev/null | grep -q homevpn-eap && echo 1 || echo 0)"
		# precheck state (written by init.d apply_config) + applied config
		state_get() { sed -n "s/^$1=//p" /tmp/homevpn.state 2>/dev/null | head -1; }
		json_add_string  ip_mode "$(cfg ip_mode)"
		json_add_string  applied_mode "$(state_get mode)"
		json_add_string  applied_pool "$(state_get pool)"
		json_add_string  applied_masq "$(state_get masq)"
		json_add_string  lan_net "$(state_get lan_net)"
		json_add_string  suggest "$(state_get suggest)"
		pres="$(state_get result)"
		json_add_string  precheck "${pres:-pending}"
		json_add_string  precheck_reason "$(state_get reason)"
		json_add_array clients
		swanctl --list-sas 2>/dev/null | grep -E "remote '[^']+' @" > /tmp/.homevpn_sas.$$ 2>/dev/null
		while IFS= read -r line; do
			user=$(echo "$line" | sed -n "s/.*remote '\([^']*\)'.*/\1/p")
			[ -n "$user" ] || continue
			rip=$(echo "$line" | sed -n "s/.*@ \([0-9][0-9.]*\).*/\1/p")
			vip=$(echo "$line" | grep -oE '\[[0-9.]+\]' | tail -1 | tr -d '[]')
			json_add_object ""
			json_add_string user "$user"
			json_add_string vip "${vip:-?}"
			json_add_string remote_ip "${rip:-?}"
			json_close_object
		done < /tmp/.homevpn_sas.$$
		rm -f /tmp/.homevpn_sas.$$
		json_close_array
		json_dump
		;;
	list_users)
		json_init; ok; json_add_array users
		i=0
		while uci -q get "${CFG}.@user[$i]" >/dev/null 2>&1; do
			name="$(uci -q get "${CFG}.@user[$i].name")"
			[ -n "$name" ] && {
				json_add_object ""
				json_add_string name "$name"
				json_add_string fixed_ip "$(uci -q get "${CFG}.@user[$i].fixed_ip")"
				json_close_object
			}
			i=$((i+1))
		done
		json_close_array; json_dump
		;;
	add_user)
		json_get_var name name; json_get_var password password
		valid_name "$name" || err "invalid name (A-Z a-z 0-9 . _ - max 32)"
		[ -n "$password" ] || err "password required"
		[ -n "$(user_index "$name")" ] && err "user '$name' already exists"
		sid="$(uci add "$CFG" user)"
		uci -q set "${CFG}.${sid}.name=${name}"; uci -q set "${CFG}.${sid}.password=${password}"; uci -q commit "$CFG"
		regen_secrets
		json_init; ok; json_add_string name "$name"; json_dump
		;;
	del_user)
		json_get_var name name; idx="$(user_index "$name")"
		[ -n "$idx" ] || err "user '$name' not found"
		uci -q delete "${CFG}.@user[$idx]"; uci -q commit "$CFG"; regen_secrets
		json_init; ok; json_add_string name "$name"; json_dump
		;;
set_user_ip)
		# pin a user's DHCP-mode virtual IP via dnsmasq dhcp-host=id:<name>,<ip>.
		# Empty ip clears the pin (back to dynamic dnsmasq allocation).
		json_get_var name name; json_get_var ip ip
		idx="$(user_index "$name")"
		[ -n "$idx" ] || err "user '$name' not found"
		if [ -z "$ip" ]; then
			uci -q delete "${CFG}.@user[$idx].fixed_ip" 2>/dev/null
			uci -q commit "$CFG"
			regen_secrets || err "regen failed"
			json_init; ok; json_add_string name "$name"; json_add_string fixed_ip ""; json_dump
			exit 0
		fi
		# validate: dotted quad with octets <= 255
		echo "$ip" | grep -qE '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$' || err "invalid IP '$ip'"
		o1="${ip%%.*}"; rest="${ip#*.}"; o2="${rest%%.*}"; rest="${rest#*.}"; o3="${rest%%.*}"; o4="${rest##*.}"
		[ "$o1" -le 255 ] && [ "$o2" -le 255 ] && [ "$o3" -le 255 ] && [ "$o4" -le 255 ] || err "invalid IP '$ip'"
		[ "$o4" -ge 10 ] || err "x.x.x.1-9 reserved for the router"
		# must be inside the LAN subnet
		lan_ip="$(uci -q get network.lan.ipaddr)"
		[ -n "$lan_ip" ] || err "network.lan.ipaddr not set"
		[ "$o1.$o2.$o3" = "${lan_ip%.*}" ] || err "IP must be in the LAN subnet (${lan_ip%.*}.x expected)"
		[ "$ip" = "$lan_ip" ] && err "IP equals the router LAN address"
		# must not duplicate another user's fixed IP
		j=0
		while uci -q get "${CFG}.@user[$j]" >/dev/null 2>&1; do
			[ "$j" != "$idx" ] && [ "$(uci -q get "${CFG}.@user[$j].fixed_ip")" = "$ip" ] && \
				err "IP $ip already pinned to user '$(uci -q get "${CFG}.@user[$j].name")'"
			j=$((j+1))
		done
		# fail-fast: occupied by a live LAN host or an active DHCP lease
		if ping -q -w 1 -W 1 "$ip" >/dev/null 2>&1; then
			err "$ip answers ping — already occupied by a LAN host"
		fi
		[ -s /tmp/dhcp.leases ] && grep -q " $ip " /tmp/dhcp.leases && err "$ip is in an active DHCP lease"
		uci -q set "${CFG}.@user[$idx].fixed_ip=${ip}"
		uci -q commit "$CFG"
		regen_secrets || err "regen failed"
		json_init; ok; json_add_string name "$name"; json_add_string fixed_ip "$ip"; json_dump
		;;
	discover_acme)
		# Read-only: reuse the save/provision resolver for both algorithms.
		json_get_var domain domain
		command -v openssl >/dev/null 2>&1 || err "certificate query unavailable: openssl missing"
		type homevpn_acme_resolve >/dev/null 2>&1 && type homevpn_acme_valid_domain >/dev/null 2>&1 || err "certificate query unavailable: resolver missing"
		homevpn_acme_valid_domain "$domain" || err "invalid domain"
		json_init; ok; json_add_string domain "$domain"
		json_add_array types
		for kind in rsa ecc; do
			if homevpn_acme_resolve "$domain" "$kind"; then json_add_string "" "$kind"; fi
		done
		json_close_array; json_dump
		;;
	get_settings)
		json_init; ok
		json_add_string remote "$(cfg remote)"
		json_add_string vpn_name "$(cfg vpn_name)"
		json_add_string cert_mode "$(active_mode)"
		json_add_string acme_domain "$(cfg acme_domain)"
		acme_type="$(cfg acme_key_type)"
		json_add_string acme_key_type "${acme_type:-rsa}"
		json_add_string ike_enc "$(cfg ike_enc)"
		json_add_string ike_int "$(cfg ike_int)"
		json_add_string ike_dh "$(cfg ike_dh)"
		json_add_string ip_mode "$(cfg ip_mode)"
		json_add_string pool_start "$(cfg pool_start)"
		json_add_string pool_end "$(cfg pool_end)"
		json_add_string pool_subnet "$(cfg pool_subnet)"
		json_add_string masq "$(cfg masq)"
		json_dump
		;;
	set_settings)
		json_get_var v_remote remote; json_get_var v_name vpn_name
		json_get_var v_mode cert_mode; json_get_var v_acme acme_domain
		json_get_var v_type acme_key_type
		[ -n "$v_type" ] || v_type="$(cfg acme_key_type)"
		v_type="${v_type:-rsa}"
		case "$v_type" in rsa|ecc) ;; *) err "invalid ACME key type (use rsa or ecc)";; esac
		json_get_var v_ipmode ip_mode; json_get_var v_ps pool_start
		json_get_var v_pe pool_end; json_get_var v_pc pool_subnet
		json_get_var v_masq masq
		case "$v_mode" in selfsigned|import|acme) ;; *) v_mode="";; esac
		case "$v_ipmode" in lansubnet|dhcp|subnet) ;; *) v_ipmode="";; esac
		# Validate before ANY UCI write, including the unrelated server fields.
		if [ "${v_ipmode:-$(cfg ip_mode)}" = subnet ]; then
			printf '%s' "$v_pc" | grep -q '[^[:space:]]' || err "Pool subnet is required in independent subnet mode. Enter a CIDR such as 10.100.1.0/24."
			printf '%s\n' "$v_pc" | awk -F '[./]' '
				NR != 1 || NF != 5 { exit 1 }
				{ for (i = 1; i <= 4; i++) if ($i !~ /^[0-9]+$/ || length($i) > 3 || $i > 255) exit 1;
				  if ($5 !~ /^[0-9]+$/ || length($5) > 2 || $5 < 8 || $5 > 30) exit 1; }
			' || err "Enter a valid IPv4 CIDR with a prefix from /8 to /30, such as 10.100.1.0/24."
		fi
		json_get_type remote_type remote
		[ "$remote_type" = string ] || v_remote="$(cfg remote)"
		[ -z "$v_remote" ] || hv_pki_valid_remote "$v_remote" || err invalid_remote
		prev_mode="$(cfg cert_mode)"
		# switching to ACME — or changing the domain / server address while
		# in ACME mode — requires the certificate to exist AND the resulting
		# server address to be an exact SAN of it: otherwise the status page
		# would claim "ACME" while the old cert keeps serving (silent lie),
		# or every IKE_AUTH would fail on the id↔SAN mismatch. Refuse and
		# keep the previous values.
		if [ "${v_mode:-$prev_mode}" = acme ] && [ -n "$v_remote" ]; then
			[ -n "$v_acme" ] || v_acme="$(cfg acme_domain)"
			if [ -z "$v_acme" ]; then
				err "ACME domain is empty — set it to the domain issued in Services → Let's Encrypt"
			fi
			if ! acme_ready "$v_acme" "$v_type"; then
				err "$HV_ACME_ERROR; keeping previous settings"
			fi
			# server address must be an exact SAN of the ACME leaf — same
			# rule the sync enforces; catch it here so the UI sees the
			# reason instead of a silent sync-refusal in the regen log
			remote_for_check="$v_remote"
			if ! san_exact_match "$remote_for_check" "$HV_ACME_CRT"; then
				err "server address '$remote_for_check' is not an exact SAN of the ACME certificate for '$v_acme' (SANs: $(openssl x509 -in "$HV_ACME_CRT" -noout -ext subjectAltName 2>/dev/null | tail -n +2 | tr -d ' \n')) — strongSwan never matches wildcard SANs; staying in '${prev_mode:-selfsigned}' mode"
			fi
		fi
		# Missing remote preserves existing configuration; explicit empty clears it.
		json_get_type remote_type remote
		[ "$remote_type" = string ] || v_remote="$(cfg remote)"
		if [ -n "$v_remote" ]; then
			hv_pki_valid_remote "$v_remote" || err invalid_remote
		else
			out="$(/etc/init.d/homevpn unconfigure 2>&1)"; rc=$?
			[ "$rc" = 0 ] || err remote_clear_blocked
		fi
		uci -q set "${CFG}.config.remote=${v_remote}" || err "Failed to save settings"
		[ -n "$v_name" ] && uci -q set "${CFG}.config.vpn_name=${v_name}"
		[ -n "$v_mode" ] && uci -q set "${CFG}.config.cert_mode=${v_mode}"
		[ -n "$v_acme" ] && uci -q set "${CFG}.config.acme_domain=${v_acme}"
		uci -q set "${CFG}.config.acme_key_type=${v_type}"
		# pool fields: empty input clears them back to the defaults
		uci -q set "${CFG}.config.ip_mode=${v_ipmode:-lansubnet}"
		uci -q set "${CFG}.config.pool_start=${v_ps}"
		uci -q set "${CFG}.config.pool_end=${v_pe}"
		uci -q set "${CFG}.config.pool_subnet=${v_pc}"
		case "$v_masq" in 1|0) uci -q set "${CFG}.config.masq=${v_masq}" ;; esac
		# Saving and applying are separate outcomes: regen may refuse after commit.
		uci -q commit "$CFG" || err "Failed to save settings"
		if [ -z "$v_remote" ]; then
			json_init; ok; json_add_boolean saved 1; json_add_boolean applied 0
			json_add_boolean precheck_ok 0; json_add_string reason remote_required; json_dump
			return
		fi
		# Maintenance remains available while disabled, without starting charon.
		out="$(/etc/init.d/homevpn provision 2>&1)"; rc=$?
		applied=0; [ "$rc" = 0 ] && applied=1
		json_init
		json_add_boolean ok "$applied"
		json_add_boolean saved 1
		json_add_string output "$out"
		json_add_boolean precheck_ok "$applied"
		json_add_boolean applied "$applied"
		[ "$rc" = 0 ] || json_add_string error "Settings saved, but application failed."
		json_add_string precheck_reason "$(sed -n 's/^reason=//p' /tmp/homevpn.state 2>/dev/null | head -1)"
		json_dump
		;;
	ensure_selfsigned_ca)
		out="$(/etc/init.d/homevpn check-ownership 2>&1)"; [ "$?" = 0 ] || err "$out"
		hv_pki_recover || err "$HV_PKI_ERROR"
		[ "$(active_mode)" = selfsigned ] || err selfsigned_mode_required
		json_get_type replace_type replace; json_get_var replace_ca replace
		[ "$replace_type" = boolean ] || replace_ca=0
		if [ "$replace_ca" = 1 ]; then
			json_get_var expected fingerprint
			actual="$(openssl x509 -in "$CA_SELF" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2)"
			[ "$expected" = "$actual" ] || err ca_changed_retry
			pidof charon >/dev/null && err ca_rotation_requires_stopped_service
		fi
		hv_pki_ensure_ca "$replace_ca" "$([ "$replace_ca" = 1 ] && cfg remote)" || err "$HV_PKI_ERROR"
		json_init; ok; json_add_boolean changed "$HV_PKI_CHANGED"
		json_add_boolean replaced "$([ "$replace_ca" = 1 ] && [ "$HV_PKI_CHANGED" = 1 ] && echo 1 || echo 0)"
		json_dump
		;;
	provision)
		# (re)run provisioning now: PKI + conf + secrets + firewall + load
		out="$(/etc/init.d/homevpn provision 2>&1)"; rc=$?
		json_init
		json_add_string output "$out"
		# Exit status is not a JSON boolean: zero means success.
		pok=0; [ "$rc" = 0 ] && pok=1
		json_add_boolean ok "$pok"
		json_add_boolean provision_ok "$pok"
		[ "$rc" = 0 ] || json_add_string error "$out"
		json_dump
		;;
	upload_certs)
		out="$(/etc/init.d/homevpn check-ownership 2>&1)"; [ "$?" = 0 ] || err "$out"
		hv_pki_recover || err "$HV_PKI_ERROR"
		# Import own certificate: validate a candidate set server-side, then
		# atomically install PEM files into the swanctl layout. All-or-nothing:
		# any validation failure leaves the deployed files untouched.
		#   $1 server  = server certificate (PEM, fullchain ok)
		#   $2 key     = matching private key (PEM, unencrypted)
		#   $3 ca      = CA certificate (PEM) clients will be told to trust
		# Any subset may be given; a field left empty keeps the deployed file.
		json_get_var up_server server; json_get_var up_key key; json_get_var up_ca ca
		[ -n "$up_server$up_key$up_ca" ] || err "nothing to upload — pick at least one file"

		T="$(mktemp -d /tmp/homevpn-up.XXXXXX)" || err "mktemp failed"
		trap 'rm -rf "$T"; hv_lock_release' EXIT
		trap 'exit 1' INT TERM
		mkdir -p "$T/x509" "$T/x509ca" "$T/private"

		# ---- stage uploads (or fall back to the deployed files) ----
		if [ -n "$up_server" ]; then printf '%s\n' "$up_server" > "$T/x509/server.crt"; else cp "$SWANCTL/x509/homevpn-server.crt" "$T/x509/server.crt" 2>/dev/null; fi
		if [ -n "$up_key" ]; then printf '%s\n' "$up_key" > "$T/private/server.key"; else cp "$SWANCTL/private/homevpn-server.key" "$T/private/server.key" 2>/dev/null; fi
		if [ -n "$up_ca" ]; then printf '%s\n' "$up_ca" > "$T/x509ca/ca.crt"; else cp "$SWANCTL/x509ca/homevpn-ca.crt" "$T/x509ca/ca.crt" 2>/dev/null; fi

		# ---- validate the RESULTING set, fail-fast, nothing deployed yet ----
		[ -s "$T/x509/server.crt" ] && [ -s "$T/private/server.key" ] || \
			err "incomplete set: server certificate + private key required (upload both, or deploy the missing part first)"
		oerr="$(openssl x509 -in "$T/x509/server.crt" -noout 2>&1)" || err "server certificate: not a valid PEM certificate — $(echo "$oerr" | tail -1)"
		oerr="$(openssl pkey -in "$T/private/server.key" -noout 2>&1)" || err "private key: not a valid unencrypted PEM key — $(echo "$oerr" | tail -1) (export WITHOUT a passphrase)"
		openssl x509 -in "$T/x509/server.crt" -checkend 0 -noout >/dev/null 2>&1 || \
			err "server certificate expired on $(openssl x509 -in "$T/x509/server.crt" -noout -enddate 2>/dev/null | cut -d= -f2)"
		# SAN is mandatory: the client compares it against the address it dials.
		openssl x509 -in "$T/x509/server.crt" -noout -text 2>/dev/null | grep -q "Subject Alternative Name" || \
			err "server certificate has no Subject Alternative Name — clients cannot match it (reissue with SAN)"
		# The server address must EXACTLY equal one SAN of the uploaded cert —
		# charon binds local.id (the server address) to a certificate only on
		# an exact SAN match. Wildcard SANs (*.example.com) NEVER match
		# (strongSwan does not support wildcard certificates), so a cert that
		# covers the address only via wildcard can never authenticate this
		# server — every IKE_AUTH would fail. Reject it before deploying.
		san_exact_match "$(effective_remote)" "$T/x509/server.crt" || \
			err "server address '$(effective_remote)' is not an exact SAN of the uploaded certificate (SANs: $(openssl x509 -in "$T/x509/server.crt" -noout -ext subjectAltName 2>/dev/null | tail -n +2 | tr -d ' \n')) — strongSwan never matches wildcard SANs: set the server address to an exact SAN of the certificate, or reissue it with the server address as SAN"
		# key <-> cert must be a pair
		cert_pub="$(openssl x509 -in "$T/x509/server.crt" -pubkey -noout 2>/dev/null | openssl sha256 2>/dev/null | awk '{print $NF}')"
		key_pub="$(openssl pkey -in "$T/private/server.key" -pubout 2>/dev/null | openssl sha256 2>/dev/null | awk '{print $NF}')"
		[ -n "$cert_pub" ] && [ "$cert_pub" = "$key_pub" ] || err "private key does not match the server certificate (public keys differ)"
		# CA (if present in the resulting set): valid PEM + actually signs the server cert
		ca_warn=""
		if [ -s "$T/x509ca/ca.crt" ]; then
			oerr="$(openssl x509 -in "$T/x509ca/ca.crt" -noout 2>&1)" || err "CA certificate: not a valid PEM certificate — $(echo "$oerr" | tail -1)"
			if ! openssl verify -CAfile "$T/x509ca/ca.crt" "$T/x509/server.crt" >/dev/null 2>&1; then
				[ -n "$up_ca" ] && err "CA certificate does not sign the server certificate — import the issuer CA, or leave the CA field empty to keep the current one"
				ca_warn="deployed CA does not sign the uploaded server certificate — clients that trust this CA will reject it"
			fi
		else
			ca_warn="no CA deployed — client profiles embed the CA, so upload one or the generated profiles cannot verify the server"
		fi

		# Publish leaf/key/optional CA and receipt in the same undo journal.
		# CA-only uploads retain the current leaf's provenance (including unknown).
		cp "$T/x509/server.crt" "$T/homevpn-server.crt" || err pki_publish_failed
		cp "$T/private/server.key" "$T/homevpn-server.key" || err pki_publish_failed
		chmod 600 "$T/homevpn-server.key" || err pki_publish_failed
		set -- "$SWANCTL/x509/homevpn-server.crt" "$SWANCTL/private/homevpn-server.key"
		ca_installed=0
		if [ -s "$T/x509ca/ca.crt" ]; then
			cp "$T/x509ca/ca.crt" "$T/homevpn-ca.crt" || err pki_publish_failed
			set -- "$@" "$SWANCTL/x509ca/homevpn-ca.crt"
			ca_installed=1
		fi
		if [ -n "$up_server" ]; then
			hv_pki_publish_cert "$T" import "$@" || err "$HV_PKI_ERROR"
		else
			hv_pki_publish "$T" "$@" || err "$HV_PKI_ERROR"
		fi
		if [ "$ca_installed" = 1 ]; then
			rm -f "$SWANCTL"/x509ca/homevpn-acme*.crt
		fi
		# switch to import mode (idempotent) so the app never overwrites these files
		[ "$(cfg cert_mode)" = "import" ] || { uci -q set "${CFG}.config.cert_mode=import"; uci -q commit "$CFG"; }
		# hot-reload credentials into the running charon (no restart, clients stay up)
		if [ "$(cfg enabled)" != 0 ] && pidof charon >/dev/null; then
			swanctl --load-creds --clear --noprompt >/dev/null 2>&1 || err "certificates installed, but credential reload failed"
		fi
		rm -rf "$T"
		json_init; ok
		json_add_string subject "$(openssl x509 -in "$SWANCTL/x509/homevpn-server.crt" -noout -subject 2>/dev/null | sed 's/^subject=//')"
		json_add_string san "$(openssl x509 -in "$SWANCTL/x509/homevpn-server.crt" -noout -ext subjectAltName 2>/dev/null | tail -n +2 | tr -d ' ' | tr '\n' ',' | sed 's/,$//')"
		json_add_string expires "$(openssl x509 -in "$SWANCTL/x509/homevpn-server.crt" -noout -enddate 2>/dev/null | cut -d= -f2)"
		json_add_boolean ca_installed "$ca_installed"
		[ -n "$ca_warn" ] && json_add_string warning "$ca_warn"
		json_dump
		;;
	download)
		hv_pki_recover || err "$HV_PKI_ERROR"
		json_get_var name name; json_get_var what what
		REMOTE="$(effective_remote)"
		if [ "$what" != ca ]; then
			hv_pki_valid_remote "$REMOTE" || err remote_required
			[ -s "$SRV_CERT" ] && san_exact_match "$REMOTE" "$SRV_CERT" || err leaf_san_mismatch
			if [ "$(active_mode)" = selfsigned ]; then hv_pki_leaf_valid "$REMOTE" 0 || err "$HV_PKI_ERROR"; fi
		fi
		VPN_NAME="$(cfg vpn_name)"; [ -n "$VPN_NAME" ] || VPN_NAME="Home VPN"
		IKE_ENC="$(cfg ike_enc)";   [ -n "$IKE_ENC" ] || IKE_ENC="AES-256-GCM"
		IKE_INT="$(cfg ike_int)";   [ -n "$IKE_INT" ] || IKE_INT="SHA2-384"
		IKE_DH="$(cfg ike_dh)";     [ -n "$IKE_DH" ] || IKE_DH="20"
		case "$what" in
		mobileconfig)
			caf="$(ca_file)"
			[ -n "$caf" ] || err "CA not found — run provisioning first"
			[ -n "$REMOTE" ] || err "server address not set — set it in Settings first"
			idx="$(user_index "$name")"; [ -n "$idx" ] || err "user '$name' not found"
			pw="$(uci -q get "${CFG}.@user[$idx].password")"
			ca_b64="$(openssl x509 -in "$caf" -outform DER 2>/dev/null | base64 | tr -d '\n')"
			u1="$(cat /proc/sys/kernel/random/uuid)"; u2="$(cat /proc/sys/kernel/random/uuid)"; u3="$(cat /proc/sys/kernel/random/uuid)"
			plist="<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">
<plist version=\"1.0\">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key><string>com.apple.security.root</string>
      <key>PayloadUUID</key><string>${u1}</string>
      <key>PayloadIdentifier</key><string>com.homevpn.ca</string>
      <key>PayloadVersion</key><integer>1</integer>
      <key>PayloadDisplayName</key><string>${VPN_NAME} CA</string>
      <key>PayloadCertificateFileName</key><string>ca.crt</string>
      <key>PayloadContent</key>
      <data>${ca_b64}</data>
    </dict>
    <dict>
      <key>PayloadType</key><string>com.apple.vpn.managed</string>
      <key>PayloadUUID</key><string>${u2}</string>
      <key>PayloadIdentifier</key><string>com.homevpn.vpn</string>
      <key>PayloadVersion</key><integer>1</integer>
      <key>PayloadDisplayName</key><string>${VPN_NAME}</string>
      <key>UserDefinedName</key><string>${VPN_NAME}</string>
      <key>VPNType</key><string>IKEv2</string>
      <key>IKEv2</key>
      <dict>
        <key>RemoteAddress</key><string>${REMOTE}</string>
        <key>RemoteIdentifier</key><string>${REMOTE}</string>
        <key>LocalIdentifier</key><string>${name}</string>
        <key>AuthenticationMethod</key><string>None</string>
        <key>ExtendedAuthEnabled</key><integer>1</integer>
        <key>AuthName</key><string>${name}</string>
        <key>AuthPassword</key><string>${pw}</string>
        <key>DeadPeerDetectionRate</key><string>Medium</string>
        <key>EnablePFS</key><true/>
        <key>IKESecurityAssociationParameters</key>
        <dict>
          <key>EncryptionAlgorithm</key><string>${IKE_ENC}</string>
          <key>IntegrityAlgorithm</key><string>${IKE_INT}</string>
          <key>DiffieHellmanGroup</key><integer>${IKE_DH}</integer>
        </dict>
        <key>ChildSecurityAssociationParameters</key>
        <dict>
          <key>EncryptionAlgorithm</key><string>${IKE_ENC}</string>
          <key>IntegrityAlgorithm</key><string>${IKE_INT}</string>
          <key>DiffieHellmanGroup</key><integer>${IKE_DH}</integer>
        </dict>
      </dict>
    </dict>
  </array>
  <key>PayloadDisplayName</key><string>${VPN_NAME}</string>
  <key>PayloadIdentifier</key><string>com.homevpn.profile.${name}</string>
  <key>PayloadType</key><string>Configuration</string>
  <key>PayloadUUID</key><string>${u3}</string>
  <key>PayloadVersion</key><integer>1</integer>
</dict>
</plist>"
			json_init; ok; json_add_string name "$name"; json_add_string mobileconfig "$plist"; json_dump
			;;
		sswan)
			# Documented minimal Android profile. Proposals are negotiated by the
			# app; UI algorithm labels must not be guessed into profile strings.
			caf="$(ca_file)"
			[ -n "$caf" ] && [ -s "$caf" ] || err "CA not found — run provisioning first"
			[ -n "$REMOTE" ] || err "server address not set — set it in Settings first"
			idx="$(user_index "$name")"; [ -n "$idx" ] || err "user '$name' not found"
			tmpdir="$(mktemp -d /tmp/homevpn-sswan.XXXXXX 2>/dev/null)" || err "unable to prepare CA conversion"
			der="$tmpdir/ca.der"; b64file="$tmpdir/ca.b64"
			if ! openssl x509 -in "$caf" -outform DER -out "$der" >/dev/null 2>&1 || [ ! -s "$der" ]; then
				rm -rf "$tmpdir"; err "CA conversion failed"
			fi
			if ! base64 "$der" > "$b64file" || [ ! -s "$b64file" ]; then
				rm -rf "$tmpdir"; err "CA encoding failed"
			fi
			ca_b64="$(tr -d '\n' < "$b64file")" || { rm -rf "$tmpdir"; err "CA encoding failed"; }; rm -rf "$tmpdir"
			u="$(cat /proc/sys/kernel/random/uuid 2>/dev/null)"
			printf '%s' "$u" | grep -qE '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$' || err "UUID generation failed"
			sswan_profile() {
				json_init; json_add_string uuid "$u"; json_add_string name "$VPN_NAME"; json_add_string type "ikev2-eap"
				json_add_object remote; json_add_string addr "$REMOTE"; json_add_string id "$REMOTE"; json_add_string cert "$ca_b64"; json_close_object
				json_add_object local; json_add_string id "$name"; json_add_string eap_id "$name"; json_close_object
				json_dump
			}
			sswan="$(sswan_profile)"; [ -n "$sswan" ] || err "profile serialization failed"
			json_init; ok; json_add_string name "$name"; json_add_string sswan "$sswan"; json_dump
			;;
		ca)
			caf="$(ca_file)"
			[ -n "$caf" ] || err "CA not found — run provisioning first"
			ca_pem="$(cat "$caf" 2>/dev/null)"
			json_init; ok; json_add_string filename "homevpn-ca.crt"; json_add_string ca "$ca_pem"; json_dump
			;;
		*) err "unknown download type: $what" ;;
		esac
		;;
	*) err "unknown method: $method" ;;
	esac
	;;
esac
}

# Lock the entire transaction, not just the init subprocess after UCI/cert writes.
# rpcd launches a new shell per request; JSON fields cannot assert lock ownership.
case "${1:-}:${2:-}" in
call:status|call:download|call:ensure_selfsigned_ca|call:set_enabled|call:set_settings|call:add_user|call:del_user|call:set_user_ip|call:provision|call:upload_certs)
	. /usr/share/homevpn/service-lock.sh || err "service lock unavailable"
	hv_with_lock hv_rpc_dispatch "$@" || err "HomeVPN service is busy or transaction failed; retry shortly."
	;;
*) hv_rpc_dispatch "$@";;
esac

msgid "%s (not applied — IP mode is not DHCP)"
msgstr "%s（未生效——IP 分配模式不是 DHCP）"

msgid "%s answers ping — already occupied by a LAN host"
msgstr "%s 响应 ping，已被局域网设备占用"

msgid "%s failed: %s"
msgstr "%s失败：%s"

msgid "%s is in an active DHCP lease"
msgstr "%s 已被有效的 DHCP 租约占用"

msgid "%s is outside the LAN subnet (%s on %s) — the pool must be carved from the LAN subnet"
msgstr "%s 不在局域网子网内（%s，接口 %s），地址池必须从局域网子网中划出"

msgid "%s: not a PEM text file — export Base64 PEM (a .p12/.der needs converting first)."
msgstr "%s：不是 PEM 文本文件——请导出为 Base64 PEM 格式（.p12/.der 文件需先转换）。"

msgid "%s; keeping previous settings"
msgstr "%s；保留之前的设置"

msgid "(none deployed)"
msgstr "（尚未部署）"

msgid "(none)"
msgstr "（无）"

msgid "(not deployed)"
msgstr "（尚未部署）"

msgid "A single available key type is selected automatically. If both exist, choose RSA or ECC. Source: /etc/acme, then /etc/ssl/acme."
msgstr "只有一种可用密钥类型时会自动选择；两种类型均存在时，请选择 RSA 或 ECC。依次查找 /etc/acme 和 /etc/ssl/acme。"

msgid "ACME (Let's Encrypt)"
msgstr "使用ACME管理的证书"

msgid "ACME / Let's Encrypt"
msgstr "ACME / Let's Encrypt"

msgid "ACME certificates are recommended: they are free, quick to obtain, and avoid extra trust steps."
msgstr "推荐使用ACME申请证书，免费迅速，还可以规避额外的信任步骤。"

msgid "ACME domain"
msgstr "ACME 域名"

msgid "ACME domain is empty — set it to the domain issued in Services → Let's Encrypt"
msgstr "ACME 域名为空，请填写“服务 → Let's Encrypt”中已签发证书的域名"

msgid "Add"
msgstr "添加"

msgid "Add user"
msgstr "添加用户"

msgid "Added \"%s\"."
msgstr "已添加“%s”。"

msgid "Address changes require updating client connection settings. Leaf renewal under the same CA normally does not require installing the CA again."
msgstr "地址变更后需更新客户端连接地址和远程标识。同 CA 下续签服务器证书通常无需重新安装 CA。"

msgid "Android .sswan"
msgstr "Android .sswan"

msgid "Android: download the .sswan file and import it with the strongSwan App. The CA is imported into the App with the profile; no separate installation in the system certificate store is needed. Enter the account password when importing or connecting; if the file cannot be opened directly, use the App file picker."
msgstr "Android：下载 .sswan 文件并使用 strongSwan App 导入，CA 将随配置导入 App，无需额外安装到系统证书存储。导入或连接时输入账户密码；若无法直接打开文件，请使用 App 内的文件选择器。"

msgid "Apple devices (iPhone/iPad example): download the .mobileconfig file, transfer it to the device using WeChat or another method, and save it in \"Files\". Open it in \"Files\"; the system will prompt you to enable trust in \"Settings\"."
msgstr "苹果设备(以iPhone/iPad为例)：下载，用微信或者其他方式传输到设备，保存到\"文件\"中，然后在\"文件\"中点击下载的.mobileconfig文件，系统会提示到\"设置\"中开启信任。"

msgid "Applied. Mode: %s, pool: %s"
msgstr "已应用。模式：%s，地址池：%s"

msgid "Apply"
msgstr "应用"

msgid "Apply IP settings"
msgstr "应用VPN客户端IP分配模式"

msgid "Apply the IP allocation settings first."
msgstr "请先应用 IP 分配设置。"

msgid "Applying re-runs the prechecks and (re)loads the swanctl config; existing VPN connections survive whenever possible."
msgstr "应用时会重新执行预检查并加载 swanctl 配置，尽可能保留现有 VPN 连接。"

msgid "Applying service state…"
msgstr "正在应用服务状态…"

msgid "CA (for client profiles)"
msgstr "CA（用于客户端配置文件）"

msgid "CA certificate"
msgstr "CA 证书"

msgid "CA certificate (PEM)"
msgstr "CA 证书（PEM）"

msgid "CA certificate (for clients)"
msgstr "CA 证书（供客户端使用）"

msgid "CA certificate does not sign the server certificate — import the issuer CA, or leave the CA field empty to keep the current one"
msgstr "CA 证书并非服务器证书的签发者，请导入签发 CA，或留空 CA 字段以保留当前 CA"

msgid "CA certificate: not a valid PEM certificate — %s"
msgstr "CA 证书不是有效的 PEM 证书：%s"

msgid "CA installed — client profiles will embed it."
msgstr "CA 已安装，将嵌入客户端配置文件。"

msgid "CA not found — run provisioning first"
msgstr "未找到 CA，请先配置服务器"

msgid "Cancel"
msgstr "取消"

msgid "Cannot clear the address while strongSwan is running. Disable HomeVPN first; the saved configuration was not changed."
msgstr "strongSwan 运行时无法安全清除地址。请先关闭 HomeVPN；已保存配置未更改。"

msgid "Certificate SAN matches server address"
msgstr "证书 SAN 与服务器地址匹配"

msgid "Certificate imported: %s — SAN %s, expires %s."
msgstr "证书已导入：%s——SAN：%s，到期时间：%s。"

msgid "Certificate installation failed; previous assets were restored."
msgstr "证书安装失败，已恢复原资产。"

msgid "Certificate missing"
msgstr "缺少证书"

msgid "Certificate mode"
msgstr "证书模式"

msgid "Certificate mode: ACME (recommended)"
msgstr "证书模式： ACME （推荐）"

msgid "Certificate mode: self-signed (automatically generated)"
msgstr "证书模式：自签名（自动生成）"

msgid "Certificate query failed."
msgstr "证书查询失败。"

msgid "Certificate query failed. Edit the domain or retry; this does not mean no certificate was found."
msgstr "证书查询失败。请修改域名或重试；这并不表示未找到证书。"

msgid "Check again"
msgstr "重新检查"

msgid "Reapply saved settings"
msgstr "重新应用已保存设置"

msgid "Checking local certificates…"
msgstr "正在检查本地证书…"

msgid "Checking or creating root CA…"
msgstr "正在检查或创建根 CA…"

msgid "Clear"
msgstr "清除"

msgid "Clear fixed IP"
msgstr "清除固定 IP"

msgid "Clear server address?"
msgstr "清除服务器地址？"

msgid "Clearing the address makes HomeVPN unconfigured and disables profile exports. Certificates and accounts are kept. Disable HomeVPN first if it is running; unsafe live unloading is refused."
msgstr "清除地址将使 HomeVPN 进入未配置状态，并禁止导出连接配置；保留证书和账户。若服务正在运行，请先关闭 HomeVPN；不安全的在线卸载将被拒绝。"

msgid "Client IP allocation"
msgstr "VPN客户端IP分配模式"

msgid "Client config + actions"
msgstr "客户端配置及操作"

msgid "Client connection guide"
msgstr "客户端连接指南"

msgid "Clients use a subnet separate from the local LAN; recommended when this device is the main LAN router. When this device is a side router, expand the main-router static route guidance below after applying so local LAN devices can reach VPN users (VPN users can still access local LAN devices without it); enable \"Masquerade fallback\" only if a static route cannot be added on the main router"
msgstr "客户端使用独立于本地局域网的网段，本机作为局域网主路由时推荐使用。本机用于旁路由时，需在主路由上添加独立地址池子网的静态路由（应用后可在下方展开“主路由静态路由（旁路由场景）”查看建议命令）才可实现本地局域网设备访问VPN用户（VPN用户访问本地局域网设备不受影响）；如果无法在主路由添加静态路由，才开启“后备地址伪装”"

msgid "Clipboard API is unavailable; the command is selected for manual copying."
msgstr "剪贴板 API 不可用，命令已选中，请手动复制。"

msgid "Close"
msgstr "关闭"

msgid "Configuration check refused:"
msgstr "配置检查未通过："

msgid "Confirm"
msgstr "确认"

msgid "Connected clients"
msgstr "已连接客户端"

msgid "Connection loaded in charon"
msgstr "charon 中的连接配置"

msgid "Connection steps depend on the \"Certificate mode\" in \"Server settings\":"
msgstr "根据\"服务器设置\"中\"证书模式\"的不同，接入的步骤如下："

msgid "Copied."
msgstr "已复制。"

msgid "Copy command"
msgstr "复制命令"

msgid "Currently applied destination:"
msgstr "当前已生效目标网段："

msgid "Currently applied next hop:"
msgstr "当前已生效下一跳："

msgid "DHCP (local dnsmasq)"
msgstr "DHCP（本机 dnsmasq）"

msgid "DHCP (real LAN leases via local dnsmasq)"
msgstr "DHCP（通过本机 dnsmasq 获取真实局域网租约）"

msgid "Delete"
msgstr "删除"

msgid "Delete user \"%s\"? They will no longer be able to connect."
msgstr "确定删除用户“%s”吗？删除后该用户将无法连接。"



msgid "Disable HomeVPN"
msgstr "关闭 HomeVPN"

msgid "Disabled — strongSwan stopped"
msgstr "已关闭 — strongSwan 已停止"

msgid "Disabled, but strongSwan is still running — retry or check the conflict."
msgstr "已禁用，但 strongSwan 仍在运行，请重试或检查冲突。"

msgid "Disabling disconnects VPN clients and stops strongSwan. HomeVPN requires exclusive use of strongSwan."
msgstr "关闭将断开 VPN 连接并停止 strongSwan。HomeVPN 需要独占 strongSwan。"

msgid "Download CA"
msgstr "下载 CA"

msgid "Download CA certificate"
msgstr "下载 CA 证书"

msgid "For manual client configuration, download and install the CA certificate below."
msgstr "手动配置客户端时，请在下方下载并安装 CA 证书。"

msgid "EAP accounts"
msgstr "EAP 账户"

msgid "ECC (ECDSA)"
msgstr "ECC (ECDSA)"

msgid "EXPIRED"
msgstr "已过期"

msgid "Enable HomeVPN"
msgstr "启用 HomeVPN"

msgid "Enabled — HomeVPN connection loaded"
msgstr "已启用 — HomeVPN 连接已加载"

msgid "Enabled, but HomeVPN is not ready"
msgstr "已启用，但 HomeVPN 尚未就绪"

msgid "Enter a domain or IPv4 address, without URL, port, path or wildcard. IPv6 is not supported."
msgstr "请输入域名或 IPv4 地址，不要包含 URL、端口、路径或通配符。目前不支持 IPv6。"

msgid "Enter a username and password."
msgstr "请输入用户名和密码。"

msgid "Enter a valid IPv4 CIDR with a prefix from /8 to /30, such as 10.100.1.0/24."
msgstr "请输入有效的 IPv4 子网 CIDR，前缀长度须为 /8 至 /30，例如 10.100.1.0/24。"

msgid "Enter the domain or IP clients connect to. Use DDNS for a dynamic public IP; HomeVPN never uses the WAN IP automatically."
msgstr "填写客户端连接的域名或 IP。动态公网 IP 推荐使用 DDNS 域名；HomeVPN 不会自动使用 WAN IP。"

msgid "Enter the domain to look for local certificates."
msgstr "输入域名以查找本地证书。"

msgid "Example: %s"
msgstr "示例：%s"

msgid "Existing CA assets are invalid. Confirm replacement to migrate client trust."
msgstr "已有 CA 资产异常，必须确认更换并迁移客户端信任。"

msgid "Existing clients must install the new CA or re-import their profiles, otherwise they cannot verify the new server certificate. Certificates are replaced only after validation. Stop HomeVPN before replacing its CA."
msgstr "原有客户端必须安装新 CA 或重新导入连接配置，否则无法验证新服务器证书。新证书整套验证通过后才会替换。更换 CA 前请先关闭 HomeVPN。"

msgid "Firewall INPUT rules (500/4500/ESP)"
msgstr "防火墙 INPUT 规则（500/4500/ESP）"

msgid "Fixed IP (DHCP mode)"
msgstr "固定 IP（DHCP 模式）"

msgid "Fixed IP for \"%s\" cleared — dynamic allocation again."
msgstr "已清除“%s”的固定 IP，恢复动态分配。"

msgid "Fixed IP for \"%s\": %s — applies on the next dial-in."
msgstr "“%s”的固定 IP：%s——下次连接时生效。"

msgid "Fixed IP: only effective in DHCP mode. When set, dnsmasq assigns a fixed IP to the VPN user by username; leave empty for dynamic allocation. Changes apply on the next connection. The fixed IP must be within the LAN subnet and must not conflict with other devices."
msgstr "固定 IP：仅在 DHCP 模式下生效。填写后，dnsmasq 将按用户名为 VPN 用户分配固定 IP；留空则动态分配，修改在下次连接时生效。固定 IP 应位于局域网网段内，并避免与其他设备地址冲突。"

msgid "For manual IKEv2 setup, enter the server domain, matching remote identifier, EAP username and password. Install the CA first for self-signed certificates; usually this is unnecessary with ACME certificates. See the client connection guide in EAP accounts for device-specific instructions."
msgstr "手动配置 IKEv2 时，填写服务器域名、与其相同的远程标识、EAP 用户名和密码。使用自签名证书时需先安装 CA；使用 ACME 证书时通常无需安装。各设备的具体说明请展开 EAP 账户区域的客户端连接指南。"

msgid "Generate profile"
msgstr "生成配置文件"

msgid "Get main-router static route command (side-router mode only)"
msgstr "获取主路由静态路由命令(仅旁路由模式需要)"

msgid "Hide main-router static route"
msgstr "收起主路由静态路由"

msgid "HomeVPN"
msgstr "HomeVPN"

msgid "HomeVPN configuration refused: %s"
msgstr "HomeVPN 配置被拒绝：%s"

msgid "HomeVPN service"
msgstr "HomeVPN 服务"

msgid "Homelede customized IKEv2 + EAP-MSCHAPv2 VPN server, supporting the default clients on iOS, Android, Windows and MacOS for convenient device access to your home network."
msgstr "Homelede 定制的 IKEv2＋EAP-MSCHAPv2 VPN服务器，支持iOS、Android、Windows、MacOS默认客户端接入，实现设备便捷接入家庭网络。"

msgid "How VPN clients get their virtual IP. Every mode is prechecked before applying (pool occupancy on the LAN, DHCP availability, subnet conflicts) — a failed check refuses the change and keeps the last working configuration, with the reason shown in the status banner above."
msgstr "设置 VPN 客户端获取虚拟 IP 的方式。应用前会检查局域网地址池占用、DHCP 可用性和子网冲突；检查失败时拒绝更改，保留上一次可用配置，并在上方状态提示中显示原因。"

msgid "IP %s already pinned to user '%s'"
msgstr "IP %s 已绑定到用户“%s”"

msgid "IP allocation mode"
msgstr "IP 分配模式"

msgid "IP allocation mode (applied)"
msgstr "VPN客户端IP分配模式"

msgid "IP equals the router LAN address"
msgstr "IP 与路由器局域网地址相同"

msgid "IP must be in the LAN subnet (%s expected)"
msgstr "IP 必须位于局域网子网中（应为 %s）"

msgid "Import certificate"
msgstr "导入证书"

msgid "Import own certificate"
msgstr "导入自有证书"

msgid "Import own certificate (PEM)"
msgstr "导入自有证书（PEM）"

msgid "Import mode"
msgstr "导入模式"

msgid "ACME candidates are not deployed certificates. Only a successful certificate installation changes deployment; current deployment is shown separately below."
msgstr "ACME 检测结果仅为候选证书，并非已部署证书。只有成功安装证书才会改变当前部署；实际已部署证书详情在下方单独显示。"

msgid "No certificate deployed yet."
msgstr "尚未部署证书。"

msgid "Currently deployed certificate"
msgstr "当前已部署证书"

msgid "Certificate source"
msgstr "证书来源"

msgid "HomeVPN self-signed"
msgstr "HomeVPN自签"

msgid "User import"
msgstr "用户导入"

msgid "ACME"
msgstr "ACME"

msgid "Unknown"
msgstr "未知"

msgid "The current server certificate was generated by HomeVPN. Selecting import mode does not replace it; upload the certificate and private key."
msgstr "当前仍为 HomeVPN 生成的服务器证书。选择导入模式不会自动替换证书，请上传证书和私钥。"

msgid "The current server certificate comes from ACME, not a user import. Selecting import mode does not replace it; upload the certificate and private key."
msgstr "当前仍为 ACME 管理的服务器证书，并非用户导入。选择导入模式不会自动替换证书，请上传证书和私钥。"

msgid "The current server certificate was uploaded by the user. Upload a replacement only when needed."
msgstr "当前服务器证书由用户上传，仅在需要替换时上传新证书。"

msgid "The current certificate source is unknown. Selecting import mode does not mean a certificate has been imported; upload the certificate and private key."
msgstr "当前证书来源未知。选择导入模式不代表证书已经导入，请上传证书和私钥。"

msgid "In this mode, HomeVPN generates a certificate and signs it with the generated CA certificate. Mainstream clients do not trust self-signed certificates, so import and trust the HomeVPN CA certificate on the client before connecting."
msgstr "此模式下，HomeVPN会为您生成证书，并使用生成的CA证书自签名。由于自签名证书不会被主流客户端信任，因此在连接前需要在客户端导入并信任 HomeVPN 的 CA 证书。"

msgid "Independent subnet"
msgstr "独立子网"

msgid "Invalid server address. Use a domain or IPv4 address without URL, port or path."
msgstr "服务器地址无效。请填写域名或 IPv4 地址，不包含 URL、端口或路径。"

msgid "Issuer"
msgstr "签发者"

msgid "LAN subnet pool + ARP proxy"
msgstr "局域网子网地址池 + ARP 代理"

msgid "Listening (500/4500)"
msgstr "端口监听（500/4500）"

msgid "Local certificate found. The server address will be checked against its SAN when saving."
msgstr "已找到本地证书。保存时将检查服务器地址是否与证书 SAN 匹配。"

msgid "MISMATCH — server address must be an exact SAN (wildcards never match)"
msgstr "不匹配——服务器地址必须与某个 SAN 完全一致（不支持通配符匹配）"

msgid "Manual client setup (no profile)"
msgstr "手动配置客户端（不使用配置文件）"

msgid "Masquerade fallback"
msgstr "后备地址伪装"

msgid "Settings have unsaved changes. Save and apply first; deployed certificate details remain unchanged."
msgstr "设置存在未保存修改，请先保存并应用；已部署证书信息保持不变。"

msgid "No CA uploaded — the deployed CA (if any) keeps serving client profiles."
msgstr "未上传 CA，将继续使用已部署的 CA（如有）生成客户端配置文件。"

msgid "No certificate deployed yet. Upload the server certificate, its private key, and the CA certificate clients should trust (e.g. your NAS/ACME issuer CA)."
msgstr "尚未部署证书。请上传服务器证书、对应私钥，以及客户端应信任的 CA 证书（例如 NAS/ACME 的签发 CA）。"

msgid "No route command is available from the applied snapshot."
msgstr "当前已生效快照中没有可用的路由命令。"

msgid "No usable local certificate found for this domain. Issue a certificate in Services → Let's Encrypt first."
msgstr "未找到此域名的可用本地证书。请先在“服务 → Let's Encrypt”中签发证书。"

msgid "No users yet."
msgstr "尚无用户。"

msgid "Not configured"
msgstr "未配置"

msgid "Obtain addresses via local DHCP so VPN clients share the same subnet as local devices. This mode requires local dnsmasq and is only available when this device provides DHCP service for the LAN. Supports mDNS/AirPlay. To assign fixed IPs to VPN users, use the \"Fixed IP (DHCP mode)\" column in the \"EAP accounts\" section. This mode is unavailable when firewall flow offloading is enabled."
msgstr "通过本机DHCP获取地址，VPN客户端获得与本地设备相同网段的IP，此模式依赖本机dnsmasq，本机负责局域网DHCP服务时才可以使用。支持 mDNS/AirPlay。此模式支持为VPN用户分配固定 IP，在\"EAP 账户\"区域\"固定 IP（DHCP 模式）\"列设置。当防火墙开启流量卸载时此模式不可用。"

msgid "Obtain an address via local DHCP"
msgstr "通过本机DHCP获取地址"

msgid "Off (static route preferred)"
msgstr "关闭（优先使用静态路由）"

msgid "On (fallback: main router cannot route)"
msgstr "开启（后备方案：主路由无法配置路由）"

msgid "Other clients: download and install the CA certificate, trust it, then manually configure an IKEv2 connection."
msgstr "其他客户端：先下载并安装 CA 证书，并信任证书，再手动配置 IKEv2 连接。"

msgid "Pool carved from the LAN subnet (default .50-.99) — suitable for side routers where the main router provides DHCP; keep the main router DHCP allocation range clear of the addresses reserved on this device for VPN clients"
msgstr "从局域网子网划出地址池（默认 .50-.99）—— 适合旁路由使用，此时DHCP是主路由负责，注意让主路由DHCP分配IP范围避开本机为VPN客户端预留的范围"

msgid "Pool end"
msgstr "地址池结束地址"

msgid "Pool end is not a valid IP address."
msgstr "地址池结束地址不是有效的 IP 地址。"

msgid "Pool start"
msgstr "地址池起始地址"

msgid "Pool start is not a valid IP address."
msgstr "地址池起始地址不是有效的 IP 地址。"

msgid "Pool subnet (CIDR)"
msgstr "地址池子网（CIDR）"

msgid "Pool subnet is required in independent subnet mode. Enter a CIDR such as 10.100.1.0/24."
msgstr "独立子网模式必须填写子网 CIDR，例如 10.100.1.0/24。"

msgid "Preview only. The local CA is prepared after saving self-signed mode."
msgstr "仅预览。保存自签模式后才会准备本地 CA。"

msgid "Private key"
msgstr "私钥"

msgid "Private key (unencrypted)"
msgstr "私钥（未加密）"

msgid "Provision"
msgstr "配置服务器"

msgid "RSA (recommended for iPhone)"
msgstr "RSA（推荐 iPhone 使用）"

msgid "Random"
msgstr "随机生成"

msgid "Maintenance operations"
msgstr "维护操作"

msgid "Does not save current input. Checks certificates and reapplies saved settings to retry after an application failure."
msgstr "不保存当前输入。按已保存设置检查证书并重新应用，用于应用失败后的重试。"

msgid "Unsaved changes. Save and apply first."
msgstr "存在未保存修改，请先保存并应用。"

msgid "Refused: %s — the last working configuration stays active."
msgstr "已拒绝：%s——上一次可用配置仍在生效。"

msgid "Reminder: for iPhone/iPad compatibility, when requesting an ACME certificate, select an option starting with RSA in the \"Key length\" dropdown under certificate \"Advanced settings\" to generate an RSA certificate."

{
	"luci-app-homestatus": {
		"description": "Grant access to HomeLede overview extensions (disk capacity, app status, wake-on-LAN)",
		"read": {
			"ubus": {
				"luci.homestatus": [ "status", "services", "wol_targets", "netprobe" ]
			},
			"uci": [ "homestatus", "luci-wol" ]
		},
		"write": {
			"ubus": {
				"luci.homestatus": [ "restart_app", "set_config", "wake", "set_wol_targets" ]
			},
			"uci": [ "homestatus", "luci-wol" ]
		}
	}
}

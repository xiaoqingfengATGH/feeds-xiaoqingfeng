#!/bin/sh /etc/rc.common
#
# Copyright (C) 2018-2026 xiaoqingfeng (xiaoqingfengatgm@gmail.com)
#
# HomeLede first-boot / boot-time automation.
# Successor of the retired lean `zzz-default-settings` uci-defaults script:
# only the items that carry value for HomeLede were carried over, each
# gated so it never fights an admin's explicit configuration.
#

START=13
NAME=homelede-autoconfig

# Runs once on first boot only. Idempotent guards inside.
firstboot()
{
    # --- timezone & NTP (lean: keep) ------------------------------------
    uci -q batch <<'UCIEOF'
set system.@system[0].timezone='CST-8'
set system.@system[0].zonename='Asia/Shanghai'
delete system.ntp.server
add_list system.ntp.server='ntp1.aliyun.com'
add_list system.ntp.server='ntp.tencent.com'
add_list system.ntp.server='ntp.ntsc.ac.cn'
add_list system.ntp.server='time.apple.com'
UCIEOF
    uci -q commit system

    # --- opkg/apk mirror: tencent instead of downloads.openwrt.org -----
    # (lean: keep - foreign default mirrors are unusable on CN networks)
    for f in /etc/opkg/distfeeds.conf /etc/apk/repositories.d/distfeeds.list; do
        [ -f "$f" ] && sed -i 's#downloads.openwrt.org#mirrors.tencent.com/lede#g' "$f"
    done

    # --- dnsmasq: serve LAN only ---------------------------------------
    # (lean: keep; br-lan binding survives the noresolv native-DNS stack)
    uci -q batch <<'UCIEOF'
set dhcp.@dnsmasq[0].interface='br-lan'
commit dhcp
UCIEOF

    # dnsmasq log to /dev/null unless admin configured something real
    if ! grep -q '^log-facility' /etc/dnsmasq.conf 2>/dev/null; then
        echo "log-facility=/dev/null" >> /etc/dnsmasq.conf
    fi

    # --- clean stale firewall/user leftovers (lean: keep) ---------------
    sed -i '/REDIRECT --to-ports 53/d' /etc/firewall.user 2>/dev/null

    # --- version identity (lean: keep, buildmark-coupled) ----------------
    # /etc/buildmark is written at compile time by package/updateCompileMark.
    if [ -r /etc/buildmark ]; then
        HV=$(cat /etc/buildmark)
        LV=$(grep -o "R[0-9]\{1,\}\.[0-9]\{1,\}\.[0-9]\{1,\}" /etc/openwrt_release | head -n 1)
        sed -i '/DISTRIB_REVISION/d' /etc/openwrt_release
        echo "DISTRIB_REVISION='$HV based on OpenWrt $LV'" >> /etc/openwrt_release
        sed -i '/DISTRIB_DESCRIPTION/d' /etc/openwrt_release
        echo "DISTRIB_DESCRIPTION='HomeLede '" >> /etc/openwrt_release
        sed -i -e 's/^BUILD_ID=.*/BUILD_ID=""/' -e '/OPENWRT_RELEASE/d' /usr/lib/os-release
        echo "OPENWRT_RELEASE=\"HomeLede $HV\"" >> /usr/lib/os-release
    fi

    touch /etc/config/homeledeInit
}

# Runs on every boot (cheap, idempotent).
boot()
{
    # brand image for the infinityfreedom theme (existing behaviour)
    if [ -d /www/luci-static/infinityfreedom ]; then
        if [ ! -r /www/luci-static/infinityfreedom/images/brand.png ]; then
            cp /etc/brand /www/luci-static/infinityfreedom/images/brand.png >/dev/null 2>&1
        fi
    fi
    # LuCI menu cache refresh after the above file moves
    rm -rf /tmp/luci-modulecache/ 2>/dev/null
    rm -f /tmp/luci-indexcache 2>/dev/null
}

start()
{
    [ -f /etc/config/homeledeInit ] || firstboot
    boot
}

reload()
{
    stop
    start
}

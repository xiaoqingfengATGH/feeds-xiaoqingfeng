# HomeLede overview extensions: disk capacity + key application status
# Managed by LuCI app luci-app-homestatus.

config global 'global'
	option warn '80'
	option crit '90'
	# 「驾驶舱」页面区块开关。关掉后区块不再出现；show_apps 同时会跳过
	# 后端探测（不再轮询被监视的服务），设置页里始终可见以便随时改回来。
	# show_storage 只控制渲染：磁盘数据仍来自同一次 status() 调用，
	# 且关掉后其空间告警也不再计入顶部状态摘要。
	# 注意 warn/crit 是全局使用率阈值，磁盘与内存共用，不要绑到上面的开关。
	option show_apps '1'
	option show_wol '1'
	option show_storage '1'

# 磁盘监测默认只看真实存储：伪文件系统已在后端过滤（proc/sysfs/devpts/...）。
# 根文件系统、overlay、各挂载点由 /proc/self/mountinfo + /sys/class/block 自动发现。

# ---------------------------------------------------------------- 关键应用监视
# probe 取值与实测依据（24.10.5 真机）：
#   exe    /proc/<pid>/cmdline 的 argv[0] 基名 == match（最可靠，默认）
#   cmd    match 出现在进程完整命令行中（子串匹配，等价于 pgrep -f）
#   port   /proc/net/tcp 上存在 LISTEN，匹配本地端口
#   path   运行时产物存在（进程名无常，但有确定的运行时目录/文件）
#
# 注意：本插件运行在 rpcd 进程内，**不能**调用 ubus 的 rc/service 对象
# （会死锁直到超时），故一律直接读内核接口。

config app 'dnsmasq'
	option label 'DNS / DHCP (dnsmasq)'
	option probe 'exe'
	option init 'dnsmasq'
	option order '10'

config app 'ddnsgo'
	option id 'ddns-go'
	option label '动态域名'
	option probe 'cmd'
	option match 'ddns-go'
	option init 'ddns-go'
	option uci 'ddns-go.config.enabled'
	option note 'DDNS 动态域名'
	option order '50'

config app 'passwall2'
	option label 'PassWall2'
	option probe 'port'
	option init 'passwall2'
	option port '1070'
	option uci 'passwall2.@global[0].enabled'
	option note '进程名随节点类型变化，以本地 socks 端口为准'

config app 'homevpn'
	option id 'homevpn'
	option label 'HomeVPN (IKEv2)'
	option probe 'exe'
	option match 'charon'
	option init 'homevpn'
	option uci 'homevpn.config.enabled'
	option order '55'
	option note 'strongSwan charon 进程探测'

config app 'hometunnelctl'
	option label 'Hometunnel启停控制服务'
	option probe 'cmd'
	option init 'hometunnel-ctl'
	option match 'ctl-loop'
	option note '数据面按需启动，控制面常驻'
	option critical '0'

config app 'pushbot'
	option id 'pushbot'
	option label '全能推送'
	option probe 'cmd'
	option match '/usr/bin/pushbot/pushbot'
	option init 'pushbot'
	option uci 'pushbot.pushbot.pushbot_enable'
	option order '56'
	option note '全能推送常驻脚本'

config app 'aria2'
	option id 'aria2'
	option label 'Aria2'
	option critical '0'
	option probe 'exe'
	option match 'aria2c'
	option init 'aria2'
	option uci 'aria2.main.enabled'
	option note '下载服务 aria2c 进程探测'

config app 'dockerd'
	option label 'Docker'
	option probe 'exe'
	option init 'dockerd'
	option order '40'
	option critical '0'

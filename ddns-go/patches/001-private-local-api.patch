+	"strings"
+	"testing"
+)
+
+func TestFreshAppendFamilies(t *testing.T) {
+	for _, fs := range [][]string{{"A"}, {"AAAA"}, {"A", "AAAA"}} {
+		c := fixture()
+		c.DnsConf[0].Ipv4.Domains = nil
+		h := New(func() (config.Config, error) { return c, nil }, func(n *config.Config) error { c = *n; return nil }, func() {})
+		families := `["` + strings.Join(fs, `","`) + `"]`
+		body := `{"profile_id":"` + profileID(c, 0) + `","hostname":"new.example.com","record_types":` + families + `}`
+		for i := 0; i < 2; i++ {
+			r := httptest.NewRecorder()
+			req := httptest.NewRequest("POST", "/v1/domains/ensure", strings.NewReader(body))
+			req.Header.Set("Content-Type", "application/json")
+			h.ServeHTTP(r, req)
+			if r.Code != 200 {
+				t.Fatal(r.Body.String())
+			}
+		}
+		for _, f := range fs {
+			ds := c.DnsConf[0].Ipv4.Domains
+			if f == "AAAA" {
+				ds = c.DnsConf[0].Ipv6.Domains
+			}
+			if len(ds) != 1 || ds[0] != "new.example.com" {
+				t.Fatal(ds)
+			}
+		}
+	}
+}
+func TestProtocolValidation(t *testing.T) {
+	h := New(nil, nil, nil)
+	for _, tc := range []struct {
+		method, path, ct, body string
+		status                 int
+	}{{"GET", "/v1/domains/ensure", "", "", 405}, {"POST", "/v1/profiles", "", "", 405}, {"POST", "/v1/health", "", "", 405}, {"POST", "/v1/domains/ensure", "text/plain", "{}", 415}, {"POST", "/v1/domains/ensure", "application/json", "{", 400}} {
+		r := httptest.NewRecorder()
+		req := httptest.NewRequest(tc.method, tc.path, strings.NewReader(tc.body))
+		req.Header.Set("Content-Type", tc.ct)
+		h.ServeHTTP(r, req)
+		if r.Code != tc.status {
+			t.Fatal(tc, r.Code)
+		}
+	}
+	for _, host := range []string{"*.example.com", "example.com:80", "example.com/path", "example..com", "-host.example.com", "host_.example.com", "localhost", "192.0.2.1", strings.Repeat("a", 64) + ".com", strings.Repeat("a.", 127) + "com"} {
+		if validHostname(host) {
+			t.Fatal("accepted", host)
+		}
+	}
+}

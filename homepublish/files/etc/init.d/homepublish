START=95
STOP=10
USE_PROCD=1

# No instance until production authority exists; never revive legacy leases.
start_service() {
 /usr/bin/lua /usr/share/homepublish/product-lifecycle.lua start >/dev/null
}
stop_service() {
 /usr/bin/lua /usr/share/homepublish/product-lifecycle.lua stop >/dev/null
}
status_service() {
 /usr/bin/lua /usr/share/homepublish/product-lifecycle.lua status
}
service_triggers() {
 # No config/network restart, respawn, or automatic exposure.
 return 0
}


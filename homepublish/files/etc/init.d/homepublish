#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
START=95
STOP=10
USE_PROCD=1

# Idle controller is independent from publication. Never respawn expired intent.
# REQ-011: respawn the idle controller process only; publication recovery stays
# governed by the journal (desired_state + publication_policy.boot_restore).
start_service() {
 procd_open_instance controller
 procd_set_param command /usr/bin/lua /usr/share/homepublish/product-daemon.lua
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param respawn 3600 5 0
 procd_close_instance
}
stop_service() {
 if test -S /var/run/homepublish/control.sock; then
  echo '{"action":"stop"}' | /usr/bin/lua /usr/share/homepublish/product-device-cli.lua >/dev/null
 else
  /usr/bin/lua -e "package.path='/usr/share/homepublish/?.lua;'..package.path; require('product-controller').new(require('product-system-provider')).stop()" >/dev/null
 fi
}
status_service() {
 echo '{"action":"status"}' | /usr/bin/lua /usr/share/homepublish/product-device-cli.lua
}
service_triggers() {
 # No config/network restart, respawn, or automatic exposure.
 return 0
}
# REQ-011: system shutdown is not a manual stop. Kill the controller without
# the stop CLI so the journal keeps desired_state and boot_restore can act on
# the next boot. A user's manual stop stays an explicit LuCI/CLI action.
shutdown() {
 procd_kill homepublish
}


@@ -0,0 +1,90 @@
+package localapi
+
+import (
+	"encoding/json"
+	"github.com/jeessy2/ddns-go/v6/config"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func fixture() config.Config {
+	var c config.Config
+	d := config.DnsConfig{Name: "home", DNS: config.DNS{Name: "dnspod", ID: "SECRET-ID", Secret: "SECRET-TOKEN", ExtParam: "SECRET-EXT"}}
+	d.Ipv4.Enable = true
+	d.Ipv6.Enable = true
+	d.Ipv4.Domains = []string{"www:example.com?record_id=secret"}
+	c.DnsConf = []config.DnsConfig{d}
+	c.Password = "SECRET-PASSWORD"
+	return c
+}
+func TestEnsure(t *testing.T) {
+	for _, families := range []string{`["A"]`, `["AAAA"]`, `["A","AAAA"]`} {
+		t.Run(families, func(t *testing.T) {
+			c := fixture()
+			original := c.DnsConf[0].Ipv4.Domains[0]
+			saves, queued := 0, 0
+			h := New(func() (config.Config, error) { return c, nil }, func(next *config.Config) error { c = *next; saves++; return nil }, func() { queued++ })
+			body := `{"profile_id":"` + profileID(c, 0) + `","hostname":"WWW.Example.COM.","record_types":` + families + `}`
+			for n := 0; n < 2; n++ {
+				r := httptest.NewRecorder()
+				req := httptest.NewRequest("POST", "/v1/domains/ensure", strings.NewReader(body))
+				req.Header.Set("Content-Type", "application/json")
+				h.ServeHTTP(r, req)
+				if r.Code != 200 {
+					t.Fatal(r.Code, r.Body.String())
+				}
+			}
+			if c.DnsConf[0].Ipv4.Domains[0] != original {
+				t.Fatal("custom entry changed")
+			}
+			want := 0
+			if strings.Contains(families, "AAAA") {
+				want = 1
+			}
+			if len(c.DnsConf[0].Ipv6.Domains) != want {
+				t.Fatal(c)
+			}
+			if saves != want || queued != want {
+				t.Fatalf("saves=%d queue=%d", saves, queued)
+			}
+		})
+	}
+}
+func TestAmbiguousProfileRejected(t *testing.T) {
+	c := fixture()
+	c.DnsConf = append(c.DnsConf, c.DnsConf[0])
+	h := New(func() (config.Config, error) { return c, nil }, func(*config.Config) error { t.Fatal("saved ambiguous profile"); return nil }, nil)
+	r := httptest.NewRecorder()
+	req := httptest.NewRequest("POST", "/v1/domains/ensure", strings.NewReader(`{"profile_id":"`+profileID(c, 0)+`","hostname":"new.example.com","record_types":["A"]}`))
+	req.Header.Set("Content-Type", "application/json")
+	h.ServeHTTP(r, req)
+	if r.Code != 409 {
+		t.Fatal(r.Code)
+	}
+}
+func TestSafeProfiles(t *testing.T) {
+	c := fixture()
+	h := New(func() (config.Config, error) { return c, nil }, nil, nil)
+	r := httptest.NewRecorder()
+	h.ServeHTTP(r, httptest.NewRequest("GET", "/v1/profiles", nil))
+	if r.Code != 200 {
+		t.Fatal(r.Code, r.Body.String())
+	}
+	s := r.Body.String()
+	for _, secret := range []string{"SECRET", "record_id", "secret", "password", "dnsconf"} {
+		if strings.Contains(s, secret) {
+			t.Fatal("leaked metadata", s)
+		}
+	}
+	var result struct {
+		APIVersion int `json:"api_version"`
+		Profiles   []struct {
+			ID       string `json:"profile_id"`
+			Provider string `json:"provider"`
+		}
+	}
+	if json.Unmarshal(r.Body.Bytes(), &result) != nil || result.APIVersion != 1 || len(result.Profiles) != 1 || result.Profiles[0].ID == "" || result.Profiles[0].Provider != "dnspod" {
+		t.Fatal(s)
+	}
+}
diff --git a/localapi/ensure.go b/localapi/ensure.go
new file mode 100644
index 0000000..6415f5c
--- /dev/null
+++ b/localapi/ensure.go
@@ -0,0 +1,145 @@
+package localapi
+
+import (
+	"encoding/json"
+	"github.com/jeessy2/ddns-go/v6/config"
+	"io"
+	"mime"
+	"net"
+	"net/http"
+	"regexp"
+	"strings"
+	"sync"
+)
+
+// Only local API transactions are serialized. Upstream full-form saves retain
+// their existing semantics; clients must not edit the same config concurrently.
+var transaction sync.Mutex
+var label = regexp.MustCompile(`^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$`)
+
+func validHostname(s string) bool {
+	if len(s) > 253 || net.ParseIP(s) != nil {
+		return false
+	}
+	ls := strings.Split(s, ".")
+	if len(ls) < 2 {
+		return false
+	}
+	for _, l := range ls {
+		if !label.MatchString(l) {
+			return false
+		}
+	}
+	return true
+}
+func (a *API) ensure(w http.ResponseWriter, r *http.Request) {
+	fail := func(code int, s string) { reply(w, code, map[string]string{"error": s}) }
+	if r.Method != "POST" {
+		w.Header().Set("Allow", "POST")
+		fail(405, "method_not_allowed")
+		return
+	}
+	ct, _, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+	if err != nil || ct != "application/json" {
+		fail(415, "json_required")
+		return
+	}
+	var req struct {
+		ProfileID   string   `json:"profile_id"`
+		Hostname    string   `json:"hostname"`
+		RecordTypes []string `json:"record_types"`
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 4096)
+	dec := json.NewDecoder(r.Body)
+	dec.DisallowUnknownFields()
+	if dec.Decode(&req) != nil {
+		fail(400, "invalid_json")
+		return
+	}
+	var extra any
+	if dec.Decode(&extra) != io.EOF {
+		fail(400, "trailing_json")
+		return
+	}
+	host := strings.ToLower(strings.TrimSuffix(req.Hostname, "."))
+	if !validHostname(host) || len(req.RecordTypes) == 0 || len(req.RecordTypes) > 2 {
+		fail(400, "invalid_request")
+		return
+	}
+	seen := map[string]bool{}
+	for _, f := range req.RecordTypes {
+		if (f != "A" && f != "AAAA") || seen[f] {
+			fail(400, "invalid_record_types")
+			return
+		}
+		seen[f] = true
+	}
+	transaction.Lock()
+	defer transaction.Unlock()
+	c, err := a.load()
+	if err != nil {
+		fail(503, "config_unavailable")
+		return
+	}
+	index := -1
+	for i := range c.DnsConf {
+		if profileID(c, i) == req.ProfileID {
+			index = i
+			break
+		}
+	}
+	if index < 0 {
+		fail(409, "stale_profile")
+		return
+	}
+	// Clone all domain slices before appending: cached config is a shallow value.
+	c.DnsConf = append([]config.DnsConfig(nil), c.DnsConf...)
+	for i := range c.DnsConf {
+		d := &c.DnsConf[i]
+		d.Ipv4.Domains = append([]string(nil), d.Ipv4.Domains...)
+		d.Ipv6.Domains = append([]string(nil), d.Ipv6.Domains...)
+	}
+	d := &c.DnsConf[index]
+	for i, other := range c.DnsConf {
+		if i != index && other.Name == d.Name && other.DNS.Name == d.DNS.Name {
+			fail(409, "ambiguous_profile_name")
+			return
+		}
+	}
+	if (seen["A"] && !d.Ipv4.Enable) || (seen["AAAA"] && !d.Ipv6.Enable) {
+		fail(409, "family_disabled")
+		return
+	}
+	added, already := []string{}, []string{}
+	for _, f := range req.RecordTypes {
+		ds := &d.Ipv4.Domains
+		if f == "AAAA" {
+			ds = &d.Ipv6.Domains
+		}
+		found := false
+		for _, s := range *ds {
+			if domainName(s) == host {
+				found = true
+				break
+			}
+		}
+		if found {
+			already = append(already, f)
+		} else {
+			*ds = append(*ds, host)
+			added = append(added, f)
+		}
+	}
+	queued := false
+	if len(added) > 0 {
+		if err := a.save(&c); err != nil {
+			fail(500, "save_failed")
+			return
+		}
+		if a.queue != nil {
+			a.queue()
+			queued = true
+		}
+	}
+	reply(w, 200, map[string]any{"api_version": 1, "added": added, "already": already, "update_queued": queued})
+}

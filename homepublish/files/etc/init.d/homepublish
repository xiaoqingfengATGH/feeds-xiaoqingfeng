#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
START=95
STOP=10
USE_PROCD=1

# Idle controller is independent from publication. Never respawn expired intent.
start_service() {
 procd_open_instance controller
 procd_set_param command /usr/bin/lua /usr/share/homepublish/product-daemon.lua
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
stop_service() {
 /usr/bin/lua /usr/share/homepublish/product-lifecycle.lua stop >/dev/null
}
status_service() {
 /usr/bin/lua /usr/share/homepublish/product-lifecycle.lua status
}
service_triggers() {
 # No config/network restart, respawn, or automatic exposure.
 return 0
}


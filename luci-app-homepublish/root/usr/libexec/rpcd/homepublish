#!/bin/sh
# Fixed scoped RPC. No request-controlled command, path or provider.
case "$1:$2" in
 list:) printf '%s\n' '{"status":{},"validate":{"config":{}},"save":{"expected_revision":0,"config":{}},"stop":{}}' ;;
 call:status|call:validate|call:save|call:stop)
  /usr/bin/lua /usr/share/homepublish/product-rpc.lua "$2" |
  /usr/bin/lua /usr/share/homepublish/product-cli.lua |
  /usr/bin/lua /usr/share/homepublish/product-rpc.lua response ;;
 *) exit 1 ;;
esac

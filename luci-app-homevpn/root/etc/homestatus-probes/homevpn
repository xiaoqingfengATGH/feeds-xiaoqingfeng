#!/bin/sh
# HomeStatus: 0 running, 1 stopped, 2 unknown. Read-only; safe inside rpcd.
# Mirrors homevpn.status.running (pidof charon), NOT the UI readiness banner.
# Do not call the full RPC/init status path: it recovers PKI and writes caches.
command -v pidof >/dev/null 2>&1 || exit 2
pidof charon >/dev/null 2>&1
case "$?" in
	0) exit 0 ;;
	1) exit 1 ;;
	*) exit 2 ;;
esac

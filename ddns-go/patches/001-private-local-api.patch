new file mode 100644
index 0000000..2602a45
--- /dev/null
+++ b/localapi/socket_test.go
@@ -0,0 +1,99 @@
+package localapi
+
+import (
+	"context"
+	"errors"
+	"github.com/jeessy2/ddns-go/v6/config"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestSocketPermissionsIsolation(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "api.sock")
+	os.Chmod(filepath.Dir(p), 0700)
+	l, err := Listen(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	st, _ := os.Stat(p)
+	if st.Mode().Perm() != 0600 {
+		t.Fatal(st.Mode())
+	}
+	h := New(nil, nil, nil)
+	srv := &http.Server{Handler: h}
+	defer srv.Close()
+	go srv.Serve(l)
+	client := &http.Client{Transport: &http.Transport{DialContext: func(context.Context, string, string) (net.Conn, error) { return net.Dial("unix", p) }}}
+	for path, want := range map[string]int{"/v1/health": 200, "/save": 404, "/": 404} {
+		res, err := client.Get("http://unix" + path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		io.Copy(io.Discard, res.Body)
+		res.Body.Close()
+		if res.StatusCode != want {
+			t.Fatal(path, res.StatusCode)
+		}
+	}
+	if _, err := Listen(p); err == nil {
+		t.Fatal("replaced active socket")
+	}
+	regular := filepath.Join(t.TempDir(), "file")
+	os.WriteFile(regular, []byte("keep"), 0600)
+	if _, err := Listen(regular); err == nil {
+		t.Fatal("replaced regular file")
+	}
+}
+func TestValidationAndSaveFailure(t *testing.T) {
+	c := fixture()
+	c.DnsConf[0].Ipv6.Enable = false
+	before := c.DnsConf[0].Ipv4.Domains[0]
+	saves, queued := 0, 0
+	h := New(func() (config.Config, error) { return c, nil }, func(*config.Config) error { saves++; return errors.New("disk full") }, func() { queued++ })
+	id := profileID(c, 0)
+	cases := []struct {
+		body string
+		want int
+	}{
+		{`{"profile_id":"` + id + `","hostname":"new.example.com","record_types":["A"]}`, 500},
+		{`{"profile_id":"` + id + `","hostname":"new.example.com","record_types":["AAAA"]}`, 409},
+		{`{"profile_id":"old","hostname":"new.example.com","record_types":["A"]}`, 409},
+		{`{"profile_id":"` + id + `","hostname":"*.example.com","record_types":["A"]}`, 400},
+		{`{"profile_id":"` + id + `","hostname":"example.com:80","record_types":["A"]}`, 400},
+		{`{"profile_id":"` + id + `","hostname":"new.example.com","record_types":["TXT"]}`, 400},
+		{`{"unknown":true}`, 400}, {`{} {}`, 400}, {strings.Repeat(" ", 4097) + `{}`, 400},
+	}
+	for _, tc := range cases {
+		r := httptest.NewRecorder()
+		req := httptest.NewRequest("POST", "/v1/domains/ensure", strings.NewReader(tc.body))
+		req.Header.Set("Content-Type", "application/json")
+		h.ServeHTTP(r, req)
+		if r.Code != tc.want {
+			t.Fatal(tc.body, r.Code, r.Body.String())
+		}
+	}
+	if len(c.DnsConf[0].Ipv4.Domains) != 1 || c.DnsConf[0].Ipv4.Domains[0] != before || saves != 1 || queued != 0 {
+		t.Fatal("failed operation changed config")
+	}
+	other := fixture()
+	other.DnsConf = append(other.DnsConf, other.DnsConf[0])
+	other.DnsConf[1].Name = "second"
+	old := profileID(other, 0)
+	other.DnsConf[0], other.DnsConf[1] = other.DnsConf[1], other.DnsConf[0]
+	if old == profileID(other, 0) {
+		t.Fatal("reorder not detected")
+	}
+	a := fixture()
+	b := fixture()
+	b.DnsConf[0].DNS.Secret = "rotated"
+	if profileID(a, 0) != profileID(b, 0) {
+		t.Fatal("secret used in selector")
+	}
+}

#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
START=95
STOP=10
USE_PROCD=1

homepublish_plan() {
	lua /usr/share/homepublish/config-cli.lua plan
}

start_service() {
	local plan state ttl bind port stun http publish token f
	plan="$(homepublish_plan)" || return 1
	state="${plan%%
*}"
	[ "$state" = disabled ] && return 0
	[ "$state" = configured ] || return 1
	# Validated output contains no whitespace within arguments. Never eval UCI.
	set -- $plan
	[ "$#" = 6 ] || [ "$#" = 8 ] || return 1
	publish="${7:-}"; token="${8:-}"
	[ -z "$publish" ] || { [ "$publish" = publish ] && [ "$token" = /etc/homepublish/router.token ]; } || return 1
	ttl="$2"; bind="$3"; port="$4"; stun="$5"; http="$6"
	[ -x /usr/bin/natmap ] && [ -x /usr/libexec/homepublish-lease ] || return 1
	# Root-only, single-link regular TLS files; never "fix" unsafe originals.
	for f in /etc/homepublish/cert.pem /etc/homepublish/key.pem; do
		[ ! -L "$f" ] && [ "$(/usr/libexec/homepublish-lease --metadata "$f")" = '0:600:1' ] && [ -f "$f" ] || return 1
	done
	if [ "$publish" = publish ]; then
		[ -x /usr/libexec/homepublish-publish ] && [ -x /usr/bin/curl ] && [ -s /etc/ssl/certs/ca-certificates.crt ] || return 1
		/usr/libexec/homepublish-lease --check-publication "$token" || return 1
	fi
	# Read-only init: failed ubus submission or init death cannot strand TLS.
	# Native guardian is established before monitored provisioning starts.
	procd_open_instance lease &&
	procd_set_param command /usr/libexec/homepublish-lease --provision "$ttl" "$bind" "$port" "$stun" "$http" ${publish:+"$publish"} &&
	# One manually requested bounded lease. NO respawn/reload auto-extension.
	procd_set_param term_timeout 1 &&
	procd_set_param stdout 0 &&
	procd_set_param stderr 1 &&
	procd_close_instance || return 1
}

service_triggers() {
	# Deliberately no config/network reload restart or firewall hooks.
	return 0
}

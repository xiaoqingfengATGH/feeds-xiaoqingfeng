@@ -0,0 +1,67 @@
+package dns
+
+import (
+	"fmt"
+	"github.com/jeessy2/ddns-go/v6/config"
+	"github.com/jeessy2/ddns-go/v6/util"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+// Isolated adapter contract: mock HTTP only, no public DNS or provider accounts.
+func TestLocalAPIDnspodAdapterContract(t *testing.T) {
+	for _, tc := range []struct{ name, records, write string }{{"create", "[]", "/Record.Create"}, {"reuse_update", `[{"id":"record-7","value":"192.0.2.1"}]`, "/Record.Modify"}, {"unchanged", `[{"id":"record-7","value":"192.0.2.2"}]`, ""}} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := []string{}
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				r.ParseForm()
+				calls = append(calls, r.URL.Path)
+				if r.Form.Get("domain") != "example.com" || r.Form.Get("sub_domain") != "new" || r.Form.Get("record_type") != "A" {
+					t.Error("bad record", r.Form)
+				}
+				if r.URL.Path == "/Record.List" {
+					fmt.Fprintf(w, `{"status":{"code":"1"},"records":%s}`, tc.records)
+				} else {
+					if r.URL.Path != tc.write {
+						t.Error("wrong mutation", r.URL.Path)
+					}
+					if tc.write == "/Record.Modify" && r.Form.Get("record_id") != "record-7" {
+						t.Error("did not reuse record")
+					}
+					if r.Form.Get("value") != "192.0.2.2" {
+						t.Error("wrong IP")
+					}
+					io.WriteString(w, `{"status":{"code":"1"}}`)
+				}
+			}))
+			defer srv.Close()
+			client := &http.Client{Transport: localRewriteTransport{base: srv.URL}}
+			d := Dnspod{DNS: config.DNS{ID: "fixture", Secret: "fixture"}, TTL: "600", httpClient: client, Domains: config.Domains{Ipv4Addr: "192.0.2.2", Ipv4Cache: &util.IpCache{}, Ipv6Cache: &util.IpCache{}, Ipv4Domains: []*config.Domain{{DomainName: "example.com", SubDomain: "new"}}}}
+			d.AddUpdateDomainRecords()
+			want := 1
+			if tc.write != "" {
+				want = 2
+			}
+			if len(calls) != want {
+				t.Fatalf("calls=%v", calls)
+			}
+		})
+	}
+}
+
+type localRewriteTransport struct{ base string }
+
+func (tr localRewriteTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if r.URL.Host != "dnsapi.cn" {
+		return nil, fmt.Errorf("unexpected network target")
+	}
+	target := tr.base + r.URL.Path
+	req, err := http.NewRequest(r.Method, target, r.Body)
+	if err != nil {
+		return nil, err
+	}
+	req.Header = r.Header.Clone()
+	return http.DefaultTransport.RoundTrip(req)
+}

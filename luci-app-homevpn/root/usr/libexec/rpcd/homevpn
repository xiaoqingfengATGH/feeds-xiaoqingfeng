#!/bin/sh
# =============================================================================
# homevpn — rpcd backend for luci-app-homevpn
# Provisioning + EAP user management + client profiles (.mobileconfig/.sswan/CA)
# for the router-local strongSwan IKEv2 server.
# Based on luci-app-ikev2-manager (C) naughtyGitCat, MIT.
# =============================================================================
. /usr/share/libubox/jshn.sh

CFG="homevpn"
SWANCTL="/etc/swanctl"
CONN_FILE="$SWANCTL/conf.d/homevpn.conf"
SECRETS_FILE="$SWANCTL/conf.d/homevpn-eap.conf"
CA_SELF="$SWANCTL/x509ca/homevpn-ca.crt"
CA_ACME="$SWANCTL/x509ca/homevpn-acme.crt"
SRV_CERT="$SWANCTL/x509/homevpn-server.crt"

cfg() { uci -q get "${CFG}.config.$1"; }

err() { json_init; json_add_boolean ok 0; json_add_string error "$1"; json_dump; exit 0; }
ok()  { json_add_boolean ok 1; }
valid_name() { echo "$1" | grep -qE '^[A-Za-z0-9_.-]{1,32}$'; }

active_mode() {
	local m; m="$(cfg cert_mode)"; [ -n "$m" ] || m=selfsigned
	# ACME mode without a usable sync falls back per-boot in init; report truth
	echo "$m"
}

effective_remote() {
	local r; r="$(cfg remote)"
	[ -n "$r" ] && { echo "$r"; return; }
	r="$(uci -q get network.wan.ipaddr)"
	[ -n "$r" ] && { echo "$r"; return; }
	# live interface address (wan may be DHCP — nothing in UCI)
	local dev; dev="$(uci -q get network.wan.device 2>/dev/null)"
	ip -4 addr show dev "${dev:-eth1}" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1
}

ca_file() { [ -s "$CA_ACME" ] && echo "$CA_ACME" && return; [ -s "$CA_SELF" ] && echo "$CA_SELF"; }

regen_secrets() {
	# delegate to the init script's regen (single source of truth):
	# regenerates secrets + swanctl conf AND runs `swanctl --load-all`,
	# so newly added/removed EAP users are live in charon immediately
	# (without load-all, charon keeps its in-memory secrets and EAP auth
	# for the new user fails with "EAP-MS-CHAPv2 verification failed").
	if ! /etc/init.d/homevpn regen >/tmp/homevpn-regen.log 2>&1; then
		logger -t homevpn-rpcd "regen failed: $(tail -1 /tmp/homevpn-regen.log)"
		return 1
	fi
}

user_index() {
	local i=0
	while uci -q get "${CFG}.@user[$i]" >/dev/null 2>&1; do
		[ "$(uci -q get "${CFG}.@user[$i].name")" = "$1" ] && { echo "$i"; return; }
		i=$((i+1))
	done
}

plist_header() { # $1=vpn_name $2=name $3=uuid
cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
PLIST
}

case "$1" in
list)
	json_init
	json_add_object "status";       json_close_object
	json_add_object "list_users";   json_close_object
	json_add_object "add_user";     json_add_string name ""; json_add_string password ""; json_close_object
	json_add_object "del_user";     json_add_string name ""; json_close_object
	json_add_object "set_user_ip";  json_add_string name ""; json_add_string ip ""; json_close_object
	json_add_object "get_settings"; json_close_object
	json_add_object "set_settings"; json_add_string remote ""; json_add_string vpn_name ""; json_add_string cert_mode ""; json_add_string acme_domain ""; json_close_object
	json_add_object "provision";    json_close_object
	json_add_object "download";     json_add_string name ""; json_add_string what ""; json_close_object
	json_dump
	;;
call)
	method="$2"; read -r input; [ -n "$input" ] && json_load "$input"
	case "$method" in
	status)
		json_init; ok
		json_add_boolean running "$(pgrep charon >/dev/null && echo 1 || echo 0)"
		json_add_boolean listening "$(netstat -lnu 2>/dev/null | grep -qE ':(500|4500) ' && echo 1 || echo 0)"
		json_add_string  mode "$(active_mode)"
		json_add_string  remote "$(effective_remote)"
		caf="$(ca_file)"
		json_add_boolean pki_ready "$([ -n "$caf" ] && echo 1 || echo 0)"
		# SAN check: cert SAN must equal remote (the one hard rule).
		# openssl prints "IP Address:1.2.3.4" / "DNS:foo.example" — normalize.
		san_ok=0
		if [ -n "$caf" ] && [ -s "$SRV_CERT" ]; then
			cert_san="$(openssl x509 -in "$SRV_CERT" -noout -text 2>/dev/null | grep -A1 "Subject Alternative Name" | tail -1 | sed 's/IP Address:/IP:/g; s/ //g')"
			echo "$cert_san" | grep -qi "DNS:$(effective_remote)\\|IP:$(effective_remote)" && san_ok=1
		fi
		json_add_boolean san_ok "$san_ok"
		json_add_boolean input_rules "$(/etc/init.d/firewall status >/dev/null 2>&1; uci -q get firewall.homevpn_nat_t >/dev/null && echo 1 || echo 0)"
		json_add_boolean conn_loaded "$(swanctl --list-conn 2>/dev/null | grep -q homevpn-eap && echo 1 || echo 0)"
		# precheck state (written by init.d apply_config) + applied config
		state_get() { sed -n "s/^$1=//p" /tmp/homevpn.state 2>/dev/null | head -1; }
		json_add_string  ip_mode "$(cfg ip_mode)"
		json_add_string  applied_mode "$(state_get mode)"
		json_add_string  applied_pool "$(state_get pool)"
		json_add_string  applied_masq "$(state_get masq)"
		json_add_string  lan_net "$(state_get lan_net)"
		json_add_string  suggest "$(state_get suggest)"
		pres="$(state_get result)"
		json_add_string  precheck "${pres:-pending}"
		json_add_string  precheck_reason "$(state_get reason)"
		json_add_array clients
		swanctl --list-sas 2>/dev/null | grep -E "remote '[^']+' @" > /tmp/.homevpn_sas.$$ 2>/dev/null
		while IFS= read -r line; do
			user=$(echo "$line" | sed -n "s/.*remote '\([^']*\)'.*/\1/p")
			[ -n "$user" ] || continue
			rip=$(echo "$line" | sed -n "s/.*@ \([0-9][0-9.]*\).*/\1/p")
			vip=$(echo "$line" | grep -oE '\[[0-9.]+\]' | tail -1 | tr -d '[]')
			json_add_object ""
			json_add_string user "$user"
			json_add_string vip "${vip:-?}"
			json_add_string remote_ip "${rip:-?}"
			json_close_object
		done < /tmp/.homevpn_sas.$$
		rm -f /tmp/.homevpn_sas.$$
		json_close_array
		json_dump
		;;
	list_users)
		json_init; ok; json_add_array users
		i=0
		while uci -q get "${CFG}.@user[$i]" >/dev/null 2>&1; do
			name="$(uci -q get "${CFG}.@user[$i].name")"
			[ -n "$name" ] && {
				json_add_object ""
				json_add_string name "$name"
				json_add_string fixed_ip "$(uci -q get "${CFG}.@user[$i].fixed_ip")"
				json_close_object
			}
			i=$((i+1))
		done
		json_close_array; json_dump
		;;
	add_user)
		json_get_var name name; json_get_var password password
		valid_name "$name" || err "invalid name (A-Z a-z 0-9 . _ - max 32)"
		[ -n "$password" ] || err "password required"
		[ -n "$(user_index "$name")" ] && err "user '$name' already exists"
		sid="$(uci add "$CFG" user)"
		uci -q set "${CFG}.${sid}.name=${name}"; uci -q set "${CFG}.${sid}.password=${password}"; uci -q commit "$CFG"
		regen_secrets
		json_init; ok; json_add_string name "$name"; json_dump
		;;
	del_user)
		json_get_var name name; idx="$(user_index "$name")"
		[ -n "$idx" ] || err "user '$name' not found"
		uci -q delete "${CFG}.@user[$idx]"; uci -q commit "$CFG"; regen_secrets
		json_init; ok; json_add_string name "$name"; json_dump
		;;
set_user_ip)
		# pin a user's DHCP-mode virtual IP via dnsmasq dhcp-host=id:<name>,<ip>.
		# Empty ip clears the pin (back to dynamic dnsmasq allocation).
		json_get_var name name; json_get_var ip ip
		idx="$(user_index "$name")"
		[ -n "$idx" ] || err "user '$name' not found"
		if [ -z "$ip" ]; then
			uci -q delete "${CFG}.@user[$idx].fixed_ip" 2>/dev/null
			uci -q commit "$CFG"
			regen_secrets || err "regen failed"
			json_init; ok; json_add_string name "$name"; json_add_string fixed_ip ""; json_dump
			exit 0
		fi
		# validate: dotted quad with octets <= 255
		echo "$ip" | grep -qE '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$' || err "invalid IP '$ip'"
		o1="${ip%%.*}"; rest="${ip#*.}"; o2="${rest%%.*}"; rest="${rest#*.}"; o3="${rest%%.*}"; o4="${rest##*.}"
		[ "$o1" -le 255 ] && [ "$o2" -le 255 ] && [ "$o3" -le 255 ] && [ "$o4" -le 255 ] || err "invalid IP '$ip'"
		[ "$o4" -ge 10 ] || err "x.x.x.1-9 reserved for the router"
		# must be inside the LAN subnet
		lan_ip="$(uci -q get network.lan.ipaddr)"
		[ -n "$lan_ip" ] || err "network.lan.ipaddr not set"
		[ "$o1.$o2.$o3" = "${lan_ip%.*}" ] || err "IP must be in the LAN subnet (${lan_ip%.*}.x expected)"
		[ "$ip" = "$lan_ip" ] && err "IP equals the router LAN address"
		# must not duplicate another user's fixed IP
		j=0
		while uci -q get "${CFG}.@user[$j]" >/dev/null 2>&1; do
			[ "$j" != "$idx" ] && [ "$(uci -q get "${CFG}.@user[$j].fixed_ip")" = "$ip" ] && \
				err "IP $ip already pinned to user '$(uci -q get "${CFG}.@user[$j].name")'"
			j=$((j+1))
		done
		# fail-fast: occupied by a live LAN host or an active DHCP lease
		if ping -q -w 1 -W 1 "$ip" >/dev/null 2>&1; then
			err "$ip answers ping — already occupied by a LAN host"
		fi
		[ -s /tmp/dhcp.leases ] && grep -q " $ip " /tmp/dhcp.leases && err "$ip is in an active DHCP lease"
		uci -q set "${CFG}.@user[$idx].fixed_ip=${ip}"
		uci -q commit "$CFG"
		regen_secrets || err "regen failed"
		json_init; ok; json_add_string name "$name"; json_add_string fixed_ip "$ip"; json_dump
		;;
	get_settings)
		json_init; ok
		json_add_string remote "$(cfg remote)"
		json_add_string vpn_name "$(cfg vpn_name)"
		json_add_string cert_mode "$(active_mode)"
		json_add_string acme_domain "$(cfg acme_domain)"
		json_add_string ike_enc "$(cfg ike_enc)"
		json_add_string ike_int "$(cfg ike_int)"
		json_add_string ike_dh "$(cfg ike_dh)"
		json_add_string ip_mode "$(cfg ip_mode)"
		json_add_string pool_start "$(cfg pool_start)"
		json_add_string pool_end "$(cfg pool_end)"
		json_add_string pool_subnet "$(cfg pool_subnet)"
		json_add_string masq "$(cfg masq)"
		json_dump
		;;
	set_settings)
		json_get_var v_remote remote; json_get_var v_name vpn_name
		json_get_var v_mode cert_mode; json_get_var v_acme acme_domain
		json_get_var v_ipmode ip_mode; json_get_var v_ps pool_start
		json_get_var v_pe pool_end; json_get_var v_pc pool_subnet
		json_get_var v_masq masq
		case "$v_mode" in selfsigned|import|acme) ;; *) v_mode="";; esac
		case "$v_ipmode" in lansubnet|dhcp|subnet) ;; *) v_ipmode="";; esac
		[ -n "$v_remote" ] && uci -q set "${CFG}.config.remote=${v_remote}"
		[ -n "$v_name" ] && uci -q set "${CFG}.config.vpn_name=${v_name}"
		[ -n "$v_mode" ] && uci -q set "${CFG}.config.cert_mode=${v_mode}"
		[ -n "$v_acme" ] && uci -q set "${CFG}.config.acme_domain=${v_acme}"
		# pool fields: empty input clears them back to the defaults
		uci -q set "${CFG}.config.ip_mode=${v_ipmode:-lansubnet}"
		uci -q set "${CFG}.config.pool_start=${v_ps}"
		uci -q set "${CFG}.config.pool_end=${v_pe}"
		uci -q set "${CFG}.config.pool_subnet=${v_pc}"
		case "$v_masq" in 1|0) uci -q set "${CFG}.config.masq=${v_masq}" ;; esac
		uci -q commit "$CFG"
		# full regen (precheck + render + apply); returns the precheck verdict
		out="$(/etc/init.d/homevpn regen 2>&1)"; rc=$?
		json_init; ok
		json_add_string output "$out"
		json_add_boolean precheck_ok "$rc"
		json_add_string precheck_reason "$(sed -n 's/^reason=//p' /tmp/homevpn.state 2>/dev/null | head -1)"
		json_dump
		;;
	provision)
		# (re)run provisioning now: PKI + conf + secrets + firewall + load
		out="$(/etc/init.d/homevpn provision 2>&1)"
		json_init; ok; json_add_string output "$out"; json_dump
		;;
	download)
		json_get_var name name; json_get_var what what
		REMOTE="$(effective_remote)"
		VPN_NAME="$(cfg vpn_name)"; [ -n "$VPN_NAME" ] || VPN_NAME="Home VPN"
		IKE_ENC="$(cfg ike_enc)";   [ -n "$IKE_ENC" ] || IKE_ENC="AES-256-GCM"
		IKE_INT="$(cfg ike_int)";   [ -n "$IKE_INT" ] || IKE_INT="SHA2-384"
		IKE_DH="$(cfg ike_dh)";     [ -n "$IKE_DH" ] || IKE_DH="20"
		case "$what" in
		mobileconfig)
			caf="$(ca_file)"
			[ -n "$caf" ] || err "CA not found — run provisioning first"
			[ -n "$REMOTE" ] || err "server address not set — set it in Settings first"
			idx="$(user_index "$name")"; [ -n "$idx" ] || err "user '$name' not found"
			pw="$(uci -q get "${CFG}.@user[$idx].password")"
			ca_b64="$(openssl x509 -in "$caf" -outform DER 2>/dev/null | base64 | tr -d '\n')"
			u1="$(cat /proc/sys/kernel/random/uuid)"; u2="$(cat /proc/sys/kernel/random/uuid)"; u3="$(cat /proc/sys/kernel/random/uuid)"
			plist="<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">
<plist version=\"1.0\">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key><string>com.apple.security.root</string>
      <key>PayloadUUID</key><string>${u1}</string>
      <key>PayloadIdentifier</key><string>com.homevpn.ca</string>
      <key>PayloadVersion</key><integer>1</integer>
      <key>PayloadDisplayName</key><string>${VPN_NAME} CA</string>
      <key>PayloadCertificateFileName</key><string>ca.crt</string>
      <key>PayloadContent</key>
      <data>${ca_b64}</data>
    </dict>
    <dict>
      <key>PayloadType</key><string>com.apple.vpn.managed</string>
      <key>PayloadUUID</key><string>${u2}</string>
      <key>PayloadIdentifier</key><string>com.homevpn.vpn</string>
      <key>PayloadVersion</key><integer>1</integer>
      <key>PayloadDisplayName</key><string>${VPN_NAME}</string>
      <key>UserDefinedName</key><string>${VPN_NAME}</string>
      <key>VPNType</key><string>IKEv2</string>
      <key>IKEv2</key>
      <dict>
        <key>RemoteAddress</key><string>${REMOTE}</string>
        <key>RemoteIdentifier</key><string>${REMOTE}</string>
        <key>LocalIdentifier</key><string>${name}</string>
        <key>AuthenticationMethod</key><string>None</string>
        <key>ExtendedAuthEnabled</key><integer>1</integer>
        <key>AuthName</key><string>${name}</string>
        <key>AuthPassword</key><string>${pw}</string>
        <key>DeadPeerDetectionRate</key><string>Medium</string>
        <key>EnablePFS</key><true/>
        <key>IKESecurityAssociationParameters</key>
        <dict>
          <key>EncryptionAlgorithm</key><string>${IKE_ENC}</string>
          <key>IntegrityAlgorithm</key><string>${IKE_INT}</string>
          <key>DiffieHellmanGroup</key><integer>${IKE_DH}</integer>
        </dict>
        <key>ChildSecurityAssociationParameters</key>
        <dict>
          <key>EncryptionAlgorithm</key><string>${IKE_ENC}</string>
          <key>IntegrityAlgorithm</key><string>${IKE_INT}</string>
          <key>DiffieHellmanGroup</key><integer>${IKE_DH}</integer>
        </dict>
      </dict>
    </dict>
  </array>
  <key>PayloadDisplayName</key><string>${VPN_NAME}</string>
  <key>PayloadIdentifier</key><string>com.homevpn.profile.${name}</string>
  <key>PayloadType</key><string>Configuration</string>
  <key>PayloadUUID</key><string>${u3}</string>
  <key>PayloadVersion</key><integer>1</integer>
</dict>
</plist>"
			json_init; ok; json_add_string name "$name"; json_add_string mobileconfig "$plist"; json_dump
			;;
		sswan)
			# strongSwan Android app profile (v1.8.0+ JSON import)
			caf="$(ca_file)"
			[ -n "$caf" ] || err "CA not found — run provisioning first"
			[ -n "$REMOTE" ] || err "server address not set — set it in Settings first"
			idx="$(user_index "$name")"; [ -n "$idx" ] || err "user '$name' not found"
			pw="$(uci -q get "${CFG}.@user[$idx].password")"
			ca_b64="$(openssl x509 -in "$caf" -outform DER 2>/dev/null | base64 | tr -d '\n')"
			u="$(cat /proc/sys/kernel/random/uuid)"
			sswan="{\"uuid\":\"$u\",\"name\":\"$VPN_NAME\",\"type\":\"ikev2-eap\",\"remote\":{\"addr\":\"$REMOTE\"},\"local\":{\"id\":\"$name\",\"eap_id\":\"$name\"},\"IKE_proposal\":\"$IKE_ENC-$IKE_INT-$IKE_DH,3DES-SHA1-MODP1024\",\"ESP_proposal\":\"$IKE_ENC-$IKE_INT-$IKE_DH,3DES-SHA1\",\"cert\":\"$ca_b64\",\"save_password\":true}"
			json_init; ok; json_add_string name "$name"; json_add_string sswan "$sswan"; json_dump
			;;
		ca)
			caf="$(ca_file)"
			[ -n "$caf" ] || err "CA not found — run provisioning first"
			ca_pem="$(cat "$caf" 2>/dev/null)"
			json_init; ok; json_add_string filename "homevpn-ca.crt"; json_add_string ca "$ca_pem"; json_dump
			;;
		*) err "unknown download type: $what" ;;
		esac
		;;
	*) err "unknown method: $method" ;;
	esac
	;;
esac

#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
START=95
STOP=10
USE_PROCD=1

# Idle controller is independent from publication. Never respawn expired intent.
# REQ-011: respawn the idle controller process only; publication recovery stays
# governed by the journal (desired_state + publication_policy.boot_restore).
start_service() {
 # An ordinary later start must never inherit an abandoned restart capability.
 if test "$HOMEPUBLISH_RESTART_HANDOFF" != 1; then
  /usr/bin/lua /usr/share/homepublish/product-restart-cli.lua clear || return 1
 fi
 procd_open_instance controller
 procd_set_param command /usr/bin/lua /usr/share/homepublish/product-daemon.lua
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param respawn 3600 5 0
 procd_close_instance
}
stop_service() {
 if test -S /var/run/homepublish/control.sock; then
  echo '{"action":"stop"}' | /usr/bin/lua /usr/share/homepublish/product-device-cli.lua >/dev/null
 else
  /usr/bin/lua -e "package.path='/usr/share/homepublish/?.lua;'..package.path; require('product-controller').new(require('product-system-provider')).stop()" >/dev/null
 fi
}
status_service() {
 echo '{"action":"status"}' | /usr/bin/lua /usr/share/homepublish/product-device-cli.lua
}
service_triggers() {
 # No config/network restart, respawn, or automatic exposure.
 return 0
}
# Restart is not a user Stop. The daemon writes /var/run/homepublish/restart;
# the fixed helper arms it only after the captured old PID/start identity exits.
# boot_restore applies to unmarked starts, never this explicit same-boot handoff.
restart_service() {
 procd_lock
 /usr/bin/lua /usr/share/homepublish/product-restart-cli.lua prepare || return 1
 if ! procd_kill homepublish; then
  /usr/bin/lua /usr/share/homepublish/product-restart-cli.lua clear
  return 1
 fi
 /usr/bin/lua /usr/share/homepublish/product-restart-cli.lua wait || return 1
 # Use rc.common's start wrapper to open/close the procd service envelope.
 HOMEPUBLISH_RESTART_HANDOFF=1 start
 local result=$?
 if test "$result" != 0; then
  /usr/bin/lua /usr/share/homepublish/product-restart-cli.lua clear
 fi
 return "$result"
}
# rc.common does not dispatch restart_service automatically.
restart() {
 restart_service "$@"
}
# REQ-011: system shutdown is not a manual stop. Kill the controller without
# the stop CLI so the journal keeps desired_state and boot_restore can act on
# the next boot. A user's manual stop stays an explicit LuCI/CLI action.
shutdown() {
 procd_kill homepublish
}

